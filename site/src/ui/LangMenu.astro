---
import { msg } from "@lingui/core/macro"
import { i18nFor } from "@/i18n"
import { bcp47, languageName, locales, type Locale } from "@/lib/routes"

interface Props {
  locale: Locale
  paths: Record<Locale, string>
  up?: boolean
  class?: string
}

const { locale, paths, up = false } = Astro.props
const label = i18nFor(locale)._(msg`Language`)
---

<details class:list={["group relative", Astro.props.class]} data-lang>
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-md py-1.5 text-sm text-ink-soft transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
    aria-label={label}
  >
    <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"
      ><circle cx="8" cy="8" r="6"></circle><path d="M2 8h12M8 2c1.7 1.6 2.5 3.6 2.5 6S9.7 12.4 8 14C6.3 12.4 5.5 10.4 5.5 8S6.3 3.6 8 2Z"></path></svg
    >
    {languageName(locale)}
    <svg class="size-3 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"
      ><path d="m3 4.5 3 3 3-3"></path></svg
    >
  </summary>
  <ul
    class:list={[
      "absolute end-0 z-[60] min-w-40 rounded-xl border border-rule bg-sheet p-1.5 shadow-[0_16px_40px_-12px_rgb(15_23_42/0.28)]",
      up ? "bottom-full mb-2" : "top-full mt-2",
    ]}
  >
    {
      locales.map((l) => (
        <li>
          <a
            class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm hover:bg-paper-deep aria-[current=true]:font-semibold"
            href={paths[l]}
            hreflang={l}
            lang={bcp47[l]}
            aria-current={l === locale ? "true" : undefined}
          >
            {languageName(l)}
            {l === locale && <span class="text-brand">✓</span>}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>("details[data-lang][open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false
    })
  })
</script>
