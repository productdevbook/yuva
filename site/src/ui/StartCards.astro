---
import type { Locale } from "@/lib/routes"
import type { HomeCopy } from "@/copy/home"
import { appUrl } from "@/lib/routes"

interface Props {
  t: HomeCopy["hero"]
  locale: Locale
  class?: string
}

const { t, locale } = Astro.props
const card = "flex flex-col gap-1.5 rounded-[10px] border p-5 text-ink"
const button = "mt-2.5 inline-flex h-9 items-center self-start rounded-md px-3.5 text-sm font-medium"
---

<div class:list={["grid [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))] gap-3", Astro.props.class]}>
  <a class:list={[card, "border-brand bg-brand-wash"]} href={appUrl(locale, { signup: "1" })}>
    <span class="text-[15px] font-semibold">{t.hosted}</span>
    <span class="text-sm leading-[21px] text-ink-2">{t.hostedBody}</span>
    <span class:list={[button, "bg-brand text-white"]}>{t.signUp}</span>
  </a>
  <a class:list={[card, "border-rule hover:bg-paper-deep"]} href={t.quickStartHref}>
    <span class="text-[15px] font-semibold">{t.selfHosted}</span>
    <span class="text-sm leading-[21px] text-ink-2">{t.selfHostedBody}</span>
    <span class:list={[button, "border border-rule-strong"]}>{t.quickStart}</span>
  </a>
</div>
