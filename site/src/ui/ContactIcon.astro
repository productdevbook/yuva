---
interface Props {
  name: "issues" | "security" | "license" | "brand"
}
const { name } = Astro.props
---

<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === "issues" && (
      <>
        <circle cx="8" cy="8" r="5.5" />
        <circle cx="8" cy="8" r="1.2" fill="currentColor" />
      </>
    )
  }
  {name === "security" && <path d="M8 1.8 3 3.8v4c0 3 2.2 5.2 5 6.4 2.8-1.2 5-3.4 5-6.4v-4z" />}
  {
    name === "license" && (
      <>
        <path d="M4 2h5.5L12 4.5V14H4z" />
        <path d="M6.2 8h3.6M6.2 10.5h3.6" />
      </>
    )
  }
  {
    name === "brand" && (
      <>
        <rect x="2.5" y="2.5" width="11" height="11" rx="3" />
        <path d="M5.8 8.4c0 1.2 1 2.2 2.2 2.2s2.2-1 2.2-2.2" />
      </>
    )
  }
</svg>
