---
import type { HomeCopy } from "@/copy/home"
import ChannelIcon from "@/ui/ChannelIcon.astro"

interface Props {
  t: HomeCopy["hero"]["inbox"]
}

const { t } = Astro.props
const products = [...new Map(t.rows.map((r) => [r.product, r.color])).entries()]
---

<div class="min-w-0 rounded-3xl bg-paper-deep p-3 sm:p-5" aria-hidden="true">
  <div class="overflow-hidden rounded-2xl border border-rule bg-sheet shadow-[0_1px_2px_rgb(15_23_42/0.04),0_20px_50px_-24px_rgb(15_23_42/0.22)]">
    <div class="flex items-center justify-between border-b border-rule px-5 py-3.5">
      <p class="text-sm font-semibold tracking-tight">{t.title}</p>
      <ul class="hidden items-center gap-3 sm:flex">
        {
          products.map(([name, color]) => (
            <li class="flex items-center gap-1.5 text-xs text-ink-faint">
              <span class:list={["size-1.5 rounded-full", color]} />
              {name}
            </li>
          ))
        }
      </ul>
    </div>
    <ul class="divide-y divide-rule">
      {
        t.rows.map((r) => (
          <li class="flex items-start gap-3.5 px-5 py-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-full border border-rule text-ink-soft">
              <ChannelIcon name={r.icon} />
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 text-sm">
                <span class="truncate font-medium">{r.name}</span>
                <span class="flex shrink-0 items-center gap-1.5 text-ink-faint">
                  <span class:list={["size-1.5 rounded-full", r.color]} />
                  {r.product}
                </span>
                <span class="ms-auto shrink-0 text-xs text-ink-faint">{r.channel}</span>
              </div>
              <p class:list={["mt-1 truncate text-sm", r.unread ? "text-ink" : "text-ink-soft"]}>{r.text}</p>
            </div>
            {r.unread && <span class="mt-1.5 size-2 shrink-0 rounded-full bg-brand" />}
          </li>
        ))
      }
    </ul>
  </div>
</div>
