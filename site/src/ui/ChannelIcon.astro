---
interface Props {
  name: "mail" | "chat" | "app" | "api"
}
---

<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    Astro.props.name === "mail" && (
      <>
        <rect x="2" y="3.5" width="12" height="9" rx="1.5" />
        <path d="M2.5 4.5 8 8.5l5.5-4" />
      </>
    )
  }
  {Astro.props.name === "chat" && <path d="M3 4.5A1.5 1.5 0 0 1 4.5 3h7A1.5 1.5 0 0 1 13 4.5v5a1.5 1.5 0 0 1-1.5 1.5H7.5L5 13.2V11h-.5A1.5 1.5 0 0 1 3 9.5z" />}
  {
    Astro.props.name === "app" && (
      <>
        <rect x="4.5" y="1.5" width="7" height="13" rx="1.6" />
        <path d="M7 12.3h2" />
      </>
    )
  }
  {Astro.props.name === "api" && <path d="M6 4 2.5 8 6 12M10 4l3.5 4L10 12" />}
</svg>
