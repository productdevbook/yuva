---
import { iconBody } from "@/lib/icon"

interface Props {
  size?: number
  class?: string
}
const { size = 28 } = Astro.props
const id = `yi${Math.random().toString(36).slice(2, 8)}`
---

<svg width={size} height={size} viewBox="0 0 1024 1024" aria-hidden="true" focusable="false" class={Astro.props.class} set:html={iconBody(id, "squircle")} />
