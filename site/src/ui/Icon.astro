---
import { paths, type IconName } from "@/lib/icons"

interface Props {
  name: IconName
  class?: string
}
---

<svg class:list={["size-5", Astro.props.class]} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
  ><path d={paths[Astro.props.name]}></path></svg
>
