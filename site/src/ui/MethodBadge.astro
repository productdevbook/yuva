---
interface Props {
  method: string
}

const colors: Record<string, string> = {
  GET: "bg-sky-500/10 text-sky-700 dark:text-sky-300",
  POST: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300",
  PUT: "bg-violet-500/10 text-violet-700 dark:text-violet-300",
  PATCH: "bg-amber-500/10 text-amber-700 dark:text-amber-300",
  DELETE: "bg-red-500/10 text-red-700 dark:text-red-300",
}
const { method } = Astro.props
---

<span class:list={["inline-flex w-16 shrink-0 justify-center rounded-md px-1.5 py-0.5 font-mono text-xs font-semibold", colors[method] ?? "bg-paper-deep text-ink-soft"]}>{method}</span>
