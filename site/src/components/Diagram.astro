---
import { msg } from "@lingui/core/macro"
import { i18nFor } from "@/i18n"
import type { Locale } from "@/lib/routes"

interface Props {
  locale: Locale
}

const i18n = i18nFor(Astro.props.locale)
const t = {
  title: i18n._(msg`How messages move through Yuva`),
  desc: i18n._(
    msg`E-mail, live chat, API requests and in-app messages arrive at Yuva, one Go binary with Postgres, which keeps inboxes, conversations and contacts. The team answers from the panel. Yuva sends signed webhooks to your backend, which sends push notifications through APNs or FCM with its own keys, so the reply reaches the app.`
  ),
  email: i18n._(msg`E-mail`),
  emailSub: i18n._(msg`Worker or any MTA`),
  chat: i18n._(msg`Live chat`),
  chatSub: i18n._(msg`<yuva-chat> widget`),
  api: i18n._(msg`API`),
  apiSub: i18n._(msg`Forms and scripts`),
  app: i18n._(msg`In-app`),
  appSub: i18n._(msg`iOS and Android SDKs`),
  core: "Yuva",
  coreSub: i18n._(msg`One Go binary`),
  model: i18n._(msg`Inboxes · conversations · contacts`),
  pg: "Postgres",
  panel: i18n._(msg`Team panel`),
  panelSub: i18n._(msg`Answer, assign, notify`),
  backend: i18n._(msg`Your backend`),
  backendSub: i18n._(msg`Signed webhooks`),
  push: "APNs / FCM",
  pushSub: i18n._(msg`Your own push keys`),
  host: i18n._(msg`Your app`),
  hostSub: i18n._(msg`Shows the reply`),
  webhooks: i18n._(msg`webhooks`),
  live: i18n._(msg`realtime`),
  pushLabel: i18n._(msg`push to the app`),
}

const left = [
  { y: 20, title: t.email, sub: t.emailSub },
  { y: 115, title: t.chat, sub: t.chatSub },
  { y: 210, title: t.api, sub: t.apiSub },
  { y: 305, title: t.app, sub: t.appSub },
]
const grid = [
  { x: 0, y: 0, title: t.email, sub: t.emailSub },
  { x: 190, y: 0, title: t.chat, sub: t.chatSub },
  { x: 0, y: 80, title: t.api, sub: t.apiSub },
  { x: 190, y: 80, title: t.app, sub: t.appSub },
]
---

<figure class="diagram">
  <svg class="diagram-wide" viewBox="0 0 1000 470" role="img" aria-labelledby="dw-title dw-desc">
    <title id="dw-title">{t.title}</title>
    <desc id="dw-desc">{t.desc}</desc>
    <defs>
      <marker id="dw-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="d-head"></path>
      </marker>
      <marker id="dw-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="d-head-warm"></path>
      </marker>
    </defs>
    {
      left.map((b) => (
        <g>
          <rect class="d-box" x="1" y={b.y} width="238" height="70" rx="14" />
          <text class="d-title" x="22" y={b.y + 30}>{b.title}</text>
          <text class="d-sub" x="22" y={b.y + 52}>{b.sub}</text>
        </g>
      ))
    }
    <path class="d-line" d="M240 55C305 55 305 160 364 160" marker-end="url(#dw-a)"></path>
    <path class="d-line" d="M240 150C300 150 305 185 364 185" marker-end="url(#dw-a)"></path>
    <path class="d-line" d="M240 245C300 245 305 215 364 215" marker-end="url(#dw-a)"></path>
    <path class="d-line" d="M240 340C305 340 305 240 364 240" marker-end="url(#dw-a)"></path>

    <rect class="d-core" x="370" y="95" width="260" height="210" rx="22"></rect>
    <text class="d-core-title" x="500" y="148" text-anchor="middle">{t.core}</text>
    <text class="d-sub" x="500" y="175" text-anchor="middle">{t.coreSub}</text>
    <text class="d-sub" x="500" y="212" text-anchor="middle">{t.model}</text>
    <rect class="d-pill" x="440" y="238" width="120" height="36" rx="18"></rect>
    <text class="d-pill-text" x="500" y="261" text-anchor="middle">{t.pg}</text>

    <path class="d-line" d="M634 165C690 165 700 105 756 105" marker-start="url(#dw-a)" marker-end="url(#dw-a)"></path>
    <text class="d-label" x="682" y="112" text-anchor="middle">{t.live}</text>
    <path class="d-line" d="M634 240C690 240 700 295 756 295" marker-end="url(#dw-a)"></path>
    <text class="d-label" x="706" y="306" text-anchor="middle">{t.webhooks}</text>

    <rect class="d-box" x="761" y="60" width="238" height="90" rx="14"></rect>
    <text class="d-title" x="782" y="98">{t.panel}</text>
    <text class="d-sub" x="782" y="122">{t.panelSub}</text>

    <rect class="d-box" x="761" y="250" width="238" height="90" rx="14"></rect>
    <text class="d-title" x="782" y="288">{t.backend}</text>
    <text class="d-sub" x="782" y="312">{t.backendSub}</text>

    <path class="d-line" d="M880 340V381" marker-end="url(#dw-a)"></path>
    <rect class="d-box d-box-warm" x="761" y="385" width="238" height="70" rx="14"></rect>
    <text class="d-title" x="782" y="415">{t.push}</text>
    <text class="d-sub" x="782" y="437">{t.pushSub}</text>

    <path class="d-line-warm" d="M760 420H140V380" marker-end="url(#dw-w)"></path>
    <text class="d-label d-label-warm" x="450" y="410" text-anchor="middle">{t.pushLabel}</text>
  </svg>

  <svg class="diagram-tall" viewBox="0 0 360 620" role="img" aria-labelledby="dt-title dt-desc">
    <title id="dt-title">{t.title}</title>
    <desc id="dt-desc">{t.desc}</desc>
    <defs>
      <marker id="dt-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="d-head"></path>
      </marker>
      <marker id="dt-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="d-head-warm"></path>
      </marker>
    </defs>
    {
      grid.map((b) => (
        <g>
          <rect class="d-box" x={b.x + 1} y={b.y + 1} width="168" height="62" rx="12" />
          <text class="d-title d-small" x={b.x + 16} y={b.y + 28}>{b.title}</text>
          <text class="d-sub d-small-sub" x={b.x + 16} y={b.y + 48}>{b.sub}</text>
        </g>
      ))
    }
    <path class="d-line" d="M180 150V186" marker-end="url(#dt-a)"></path>
    <rect class="d-core" x="30" y="192" width="300" height="160" rx="20"></rect>
    <text class="d-core-title" x="180" y="232" text-anchor="middle">{t.core}</text>
    <text class="d-sub d-small-sub" x="180" y="256" text-anchor="middle">{t.coreSub}</text>
    <text class="d-sub d-small-sub" x="180" y="284" text-anchor="middle">{t.model}</text>
    <rect class="d-pill" x="125" y="302" width="110" height="32" rx="16"></rect>
    <text class="d-pill-text" x="180" y="323" text-anchor="middle">{t.pg}</text>

    <path class="d-line" d="M130 356C130 380 85 380 85 404" marker-start="url(#dt-a)" marker-end="url(#dt-a)"></path>
    <text class="d-label" x="60" y="384" text-anchor="middle">{t.live}</text>
    <path class="d-line" d="M230 356C230 380 275 380 275 404" marker-end="url(#dt-a)"></path>
    <text class="d-label" x="310" y="384" text-anchor="middle">{t.webhooks}</text>

    <rect class="d-box" x="1" y="410" width="168" height="70" rx="12"></rect>
    <text class="d-title d-small" x="16" y="440">{t.panel}</text>
    <text class="d-sub d-small-sub" x="16" y="461">{t.panelSub}</text>
    <rect class="d-box" x="191" y="410" width="168" height="70" rx="12"></rect>
    <text class="d-title d-small" x="206" y="440">{t.backend}</text>
    <text class="d-sub d-small-sub" x="206" y="461">{t.backendSub}</text>

    <path class="d-line" d="M275 480V516" marker-end="url(#dt-a)"></path>
    <rect class="d-box d-box-warm" x="191" y="520" width="168" height="70" rx="12"></rect>
    <text class="d-title d-small" x="206" y="550">{t.push}</text>
    <text class="d-sub d-small-sub" x="206" y="571">{t.pushSub}</text>
    <path class="d-line-warm" d="M190 555H174" marker-end="url(#dt-w)"></path>
    <rect class="d-box" x="1" y="520" width="168" height="70" rx="12"></rect>
    <text class="d-title d-small" x="16" y="550">{t.host}</text>
    <text class="d-sub d-small-sub" x="16" y="571">{t.hostSub}</text>
  </svg>
</figure>
