msgid "Yuva: one open-source inbox for e-mail, live chat and in-app messages"
msgstr "Yuva: ईमेल, लाइव्ह चॅट आणि अ‍ॅपमधील संदेशांसाठी एक ओपन-सोर्स इनबॉक्स"

#: src/copy/home.ts
msgid "Zendesk and Help Scout"
msgstr "Zendesk आणि Help Scout"
