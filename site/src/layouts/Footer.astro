---
import { msg } from "@lingui/core/macro"
import { i18nFor } from "@/i18n"
import {
  ai,
  blog,
  brand,
  cloudflareEmail,
  status,
  contact,
  docsRoot,
  home,
  links,
  releases,
  templates,
  VERSION,
  type Locale,
} from "@/lib/routes"
import Cross from "@/ui/Cross.astro"
import ThemeToggle from "@/ui/ThemeToggle.astro"
import LangMenu from "@/ui/LangMenu.astro"
import Logo from "@/ui/Logo.astro"

interface Props {
  locale: Locale
  paths: Record<Locale, string>
  wide?: boolean
  inline?: boolean
}

const { locale, paths, wide = false, inline = false } = Astro.props
const i18n = i18nFor(locale)
const year = new Date().getFullYear()
const columns = [
  {
    title: i18n._(msg`Product`),
    items: [
      { href: status[locale], label: i18n._(msg`Status pages`) },
      { href: templates[locale], label: i18n._(msg`E-mail templates`) },
      { href: blog[locale], label: i18n._(msg`Blog`) },
      { href: releases[locale], label: i18n._(msg`Releases`) },
      { href: `${docsRoot(locale)}roadmap/`, label: i18n._(msg`Roadmap`) },
      { href: brand[locale], label: i18n._(msg`Brand assets`) },
    ],
  },
  {
    title: i18n._(msg`Developers`),
    items: [
      { href: docsRoot(locale), label: i18n._(msg`Documentation`) },
      { href: ai[locale], label: i18n._(msg`AI assistants`) },
      { href: cloudflareEmail[locale], label: i18n._(msg`Cloudflare e-mail`) },
      { href: `${docsRoot(locale)}api/`, label: i18n._(msg`API contract`) },
      { href: links.repo, label: i18n._(msg`Source code on GitHub`) },
      { href: links.x, label: i18n._(msg`Yuva on X`) },
    ],
  },
  {
    title: i18n._(msg`Project`),
    items: [
      { href: contact[locale], label: i18n._(msg`Contact`) },
      { href: links.licensing, label: i18n._(msg`Licensing`) },
      { href: links.contributing, label: i18n._(msg`Contributing`) },
      { href: links.security, label: i18n._(msg`Report a vulnerability`) },
    ],
  },
]
const link = "text-ink-2 underline-offset-4 hover:text-ink hover:underline"
---

<footer
  class:list={["text-[13px] text-ink-soft", inline ? "mt-24 border-t border-rule-soft pt-6" : "border-t border-rule"]}
>
  <div
    class:list={[!inline && "relative mx-auto", !inline && (wide ? "max-w-none" : "max-w-6xl border-x border-rule")]}
  >
    {!inline && !wide && <Cross class="-start-[6px] -top-[6px]" />}
    {!inline && !wide && <Cross class="-end-[6px] -top-[6px]" />}
    <div
      class:list={[
        "grid [grid-template-columns:repeat(auto-fit,minmax(160px,1fr))] gap-6",
        !inline && "px-5 py-12 sm:px-8",
        !inline && wide && "lg:px-6",
      ]}
    >
      <div class="flex flex-col gap-1.5">
        <a class="inline-flex items-center gap-2 font-semibold text-ink" href={home[locale]}>
          <Logo size={18} />
          Yuva {VERSION}
        </a>
        <p>{i18n._(msg`Open-source customer messaging for teams that run many products.`)}</p>
        <p class="text-ink-faint">{i18n._(msg`“Yuva” is Turkish for nest, or home.`)}</p>
      </div>
      {columns.map((c) => (
        <nav class="flex flex-col gap-1.5" aria-label={c.title}>
          <h2 class="font-medium text-ink-faint">{c.title}</h2>
          <ul class="flex flex-col gap-1.5">
            {c.items.map((i) => (
              <li>
                <a class={link} href={i.href}>
                  {i.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div
      class:list={[
        "flex flex-col gap-3 border-t border-rule-soft text-ink-faint sm:flex-row sm:items-center sm:justify-between",
        inline ? "mt-8 pt-5" : "px-5 py-5 sm:px-8",
        !inline && wide && "lg:px-6",
      ]}
    >
      <p>
        {i18n._(msg`Server and panel under AGPL-3.0, SDKs and API contract under MIT.`)} © {year} productdevbook
      </p>
      {!inline && (
        <div class="flex items-center gap-3">
          <ThemeToggle locale={locale} />
          <LangMenu locale={locale} paths={paths} up />
        </div>
      )}
    </div>
    <div class:list={["min-h-[192px] border-t border-rule-soft [--yuva-status-gutter:0px]", inline && "mt-5"]}>
      <yuva-status page="useyuva" server="https://app.useyuva.com" components lang={locale} theme="auto"></yuva-status>
    </div>
  </div>
</footer>
