---
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { href, neighbours, nav, type NavItem } from "@/lib/docs"
import { docsPath, type Locale } from "@/lib/routes"
import DocsHeader from "@/layouts/DocsHeader.astro"

type Heading = { depth: number; slug: string; text: string }

interface Props {
  locale: Locale
  title: string
  description: string
  slug: string
  rel: string
  headings?: Heading[]
  meta?: string[]
  edit?: string
  image?: string
  wideContent?: boolean
}

const { locale, title, description, slug, rel, headings = [], meta = [], edit, image, wideContent = false } = Astro.props
const t = docsCopy(i18nFor(locale))
const groups = await nav(locale)
const { prev, next } = await neighbours(slug, locale)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const active = (item: NavItem) => item.slug === slug
const inside = (item: NavItem) => active(item) || !!item.children?.some((c) => c.slug === slug)
const link =
  "flex items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-ink-soft hover:bg-paper-deep hover:text-ink aria-[current=page]:bg-brand-wash aria-[current=page]:font-medium aria-[current=page]:text-brand"
---

<Base locale={locale} title={`${title} · Yuva docs`} description={description} paths={docsPath(rel)} image={image} bare>
  <DocsHeader locale={locale} paths={docsPath(rel)} section="guides" />
  <div class="grid grid-cols-1 lg:grid-cols-[17rem_minmax(0,1fr)]">
    <aside class="hidden border-e border-rule lg:block">
      <div class="sticky top-14 flex h-[calc(100svh-3.5rem)] flex-col">
        <nav class="flex-1 overflow-y-auto p-3" aria-label={t.documentation} data-sidebar>
          {
            groups.map((g) => (
              <div class="mb-5">
                <p class="px-2.5 pb-1.5 text-xs font-semibold text-ink-faint">{g.title}</p>
                <ul class="grid gap-px">
                  {g.items.map((c) => (
                    <li>
                      <a class={link} href={href(locale, c.rel)} aria-current={active(c) ? "page" : undefined}>
                        {c.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>
    </aside>

    <div class="min-w-0">
      <div class="flex items-center gap-3 border-b border-rule px-5 py-3 lg:hidden">
        <details class="group relative flex-1">
          <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl border border-rule px-4 py-2.5 text-sm font-medium [&::-webkit-details-marker]:hidden">
            {title}
            <svg class="size-4 text-ink-faint group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
          </summary>
          <nav class="absolute inset-x-0 top-full z-40 mt-2 grid max-h-[70svh] gap-4 overflow-y-auto rounded-xl border border-rule bg-sheet p-3 shadow-paper" aria-label={t.documentation}>
            {
              groups.map((g) => (
                <div>
                  <p class="px-2.5 pb-1 text-xs font-semibold text-ink-faint">{g.title}</p>
                  {[...g.items, ...g.items.flatMap((i) => (inside(i) ? (i.children ?? []) : []))].map((i) => (
                    <a class={link} href={href(locale, i.rel)} aria-current={active(i) ? "page" : undefined}>
                      {i.title}
                    </a>
                  ))}
                </div>
              ))
            }
          </nav>
        </details>
      </div>

      <div class:list={["mx-auto grid gap-12 px-5 py-10 sm:px-8 lg:px-12 lg:py-14", wideContent ? "max-w-[90rem]" : "max-w-6xl xl:grid-cols-[minmax(0,1fr)_14rem]"]}>
        <main class="min-w-0">
          <h1 class="text-[clamp(2.25rem,1.6rem+2vw,3rem)] leading-[1.06] font-semibold tracking-[-0.035em]">{title}</h1>
          <p class="mt-3 text-sm text-ink-faint">{[...meta.slice(0, 1), ...(locale !== "en" ? [t.english] : [])].join(" · ")}</p>
          <article class="docs-content mt-10" data-copy={t.copy} data-copied={t.copied}>
            <slot />
          </article>

          <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-6 text-sm">
            {prev ? <a class="text-ink-soft hover:text-ink" href={href(locale, prev.rel)}>← {prev.title}</a> : <span />}
            {next && <a class="font-medium text-brand hover:underline" href={href(locale, next.rel)}>{next.title} →</a>}
          </div>
          {edit && <p class="mt-4 text-sm"><a class="text-ink-faint hover:text-ink" href={edit}>{t.edit} →</a></p>}
        </main>

        {
          !wideContent && toc.length > 1 && (
            <aside class="hidden xl:block">
              <nav class="sticky top-24" aria-label={t.onThisPage}>
                <p class="text-xs font-semibold text-ink-faint">{t.onThisPage}</p>
                <ol class="mt-3 border-s border-rule">
                  {toc.map((h) => (
                    <li>
                      <a class:list={["-ms-px block border-s border-transparent py-1 text-sm transition-colors hover:border-ink hover:text-ink", h.depth === 3 ? "ps-6 text-ink-faint" : "ps-3 text-ink-soft"]} href={`#${h.slug}`}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
      </div>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>(".docs-content :is(h2, h3)[id]").forEach((h) => {
    const a = document.createElement("a")
    a.href = `#${h.id}`
    a.className = "heading-anchor"
    a.setAttribute("aria-hidden", "true")
    a.tabIndex = -1
    a.textContent = "#"
    h.append(a)
  })
  const article = document.querySelector<HTMLElement>(".docs-content")
  const labels: Record<string, string> = { sh: "Shell", bash: "Shell", yaml: "YAML", yml: "YAML", json: "JSON", nginx: "nginx", go: "Go", swift: "Swift", kotlin: "Kotlin", html: "HTML", js: "JavaScript", ts: "TypeScript", sql: "SQL" }
  article?.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
    const frame = document.createElement("div")
    frame.className = "code-frame"
    const bar = document.createElement("div")
    bar.className = "code-bar"
    const lang = pre.dataset.language ?? ""
    const name = document.createElement("span")
    name.textContent = labels[lang] ?? (lang === "plaintext" ? "" : lang)
    const button = document.createElement("button")
    button.type = "button"
    button.textContent = article.dataset.copy ?? "Copy"
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.innerText)
      button.textContent = article.dataset.copied ?? "Copied"
      setTimeout(() => (button.textContent = article.dataset.copy ?? "Copy"), 1400)
    })
    bar.append(name, button)
    pre.replaceWith(frame)
    frame.append(bar, pre)
  })

  const sidebar = document.querySelector<HTMLElement>("[data-sidebar]")
  const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]')
  if (sidebar && current) sidebar.scrollTop = current.offsetTop - sidebar.clientHeight / 3
</script>
