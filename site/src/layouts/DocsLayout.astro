---
import { msg } from "@lingui/core/macro"
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import PageShell from "@/layouts/PageShell.astro"
import { href, neighbours, nav } from "@/lib/docs"
import { docsPath, home as homePage, links, type Locale } from "@/lib/routes"
import TopLinks from "@/ui/TopLinks.astro"

type Heading = { depth: number; slug: string; text: string }

interface Props {
  locale: Locale
  title: string
  description: string
  slug: string
  rel: string
  headings?: Heading[]
  meta?: string[]
  edit?: string
  image?: string
  wideContent?: boolean
  english?: boolean
  home?: boolean
}

const {
  locale,
  title,
  description,
  slug,
  rel,
  headings = [],
  meta = [],
  edit,
  image,
  wideContent = false,
  english = locale !== "en",
  home = false,
} = Astro.props
const i18n = i18nFor(locale)
const t = docsCopy(i18n)
const groups = await nav(locale)
const { prev, next } = await neighbours(slug, locale)
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ href: `#${h.slug}`, label: h.text, depth: h.depth }))
const group = groups.find((g) => g.items.some((i) => i.slug === slug))
const rows = groups.map((g) => ({
  key: g.key,
  title: g.title,
  items: g.items.map((i) => ({ label: i.title, href: href(locale, i.rel), current: i.slug === slug })),
}))
const sections = [
  { label: t.guides, sub: i18n._(msg`Set up and run`), href: href(locale), current: true },
  { label: t.apiReference, sub: i18n._(msg`REST and MCP`), href: href(locale, "api/"), current: false },
]
const aside = "text-ink-2 underline-offset-4 hover:underline"
---

<Base
  locale={locale}
  title={`${title} · Yuva docs`}
  description={description}
  paths={docsPath(rel)}
  image={image}
  shell
>
  <PageShell locale={locale} paths={docsPath(rel)} label={t.documentation} groups={rows} toc={toc}>
    <Fragment slot="head">
      <div class="flex flex-col gap-0.5 px-2.5">
        <a
          class="inline-flex items-center gap-1.5 self-start text-xs leading-[18px] text-ink-soft hover:text-ink"
          href={homePage[locale]}
        >
          <span aria-hidden="true" class="rtl:-scale-x-100">
            ←
          </span>
          {i18n._(msg`Home`)}
        </a>
        <p class="text-xl leading-7 font-semibold tracking-[-0.01em]">{t.docs}</p>
      </div>
      <nav class="grid grid-cols-2 gap-0.5 rounded-lg border border-rule bg-seg p-[3px]" aria-label={t.documentation}>
        {sections.map((s) => (
          <a
            class="flex flex-col gap-px rounded-md border border-transparent px-2.5 py-1.5 aria-[current=page]:border-rule aria-[current=page]:bg-paper aria-[current=page]:shadow-[0_1px_2px_rgb(0_0_0/6%)]"
            href={s.href}
            aria-current={s.current ? "page" : undefined}
          >
            <span class="text-sm leading-[18px] font-medium">{s.label}</span>
            <span class="text-[11px] leading-[14px] text-ink-soft">{s.sub}</span>
          </a>
        ))}
      </nav>
    </Fragment>

    <div class="mb-3 flex items-center gap-2">
      <p class="flex min-w-0 flex-1 items-center gap-2 font-mono text-xs tracking-[0.04em] text-ink-faint uppercase">
        <span>{t.docs}</span>
        {group && !home && (
          <>
            <span class="text-rule-strong" aria-hidden="true">
              ·
            </span>
            <span class="size-[7px] shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
            <span class="truncate text-ink">{group.title}</span>
          </>
        )}
      </p>
      <TopLinks locale={locale} paths={docsPath(rel)} />
    </div>

    <div class:list={[!wideContent && "max-w-[720px]"]}>
      {!home && (
        <h1 class="text-[30px] leading-[38px] font-semibold tracking-[-0.02em] sm:text-4xl sm:leading-[44px]">
          {title}
        </h1>
      )}
      {english && <p class="mt-3 text-sm text-ink-faint">{t.english}</p>}
      <article class:list={["docs-content", !home && "mt-4"]} data-copy={t.copy} data-copied={t.copied}>
        <slot />
      </article>

      {!home && (prev || next) && (
        <div class="mt-16 flex flex-wrap gap-3">
          {prev && (
            <a
              class="flex flex-[1_1_240px] flex-col gap-1 rounded-[10px] border border-rule px-4 py-3.5 hover:bg-paper-deep"
              href={href(locale, prev.rel)}
            >
              <span class="text-xs text-ink-soft">{t.previous}</span>
              <span class="text-[15px] font-medium">{prev.title}</span>
            </a>
          )}
          {next && (
            <a
              class="flex flex-[1_1_240px] flex-col items-end gap-1 rounded-[10px] border border-rule px-4 py-3.5 text-end hover:bg-paper-deep"
              href={href(locale, next.rel)}
            >
              <span class="text-xs text-ink-soft">{t.next}</span>
              <span class="text-[15px] font-medium">{next.title}</span>
            </a>
          )}
        </div>
      )}
      {edit && (
        <p class="mt-10 text-sm min-[1180px]:hidden">
          <a class={aside} href={edit}>
            {t.edit}
          </a>
        </p>
      )}
    </div>

    <Fragment slot="aside">
      {(meta.length > 0 || edit) && (
        <div class="mt-6 flex flex-col gap-1.5 border-t border-rule-soft pt-3.5 text-[13px]">
          {meta.slice(0, 1).map((m) => (
            <p class="text-ink-faint">{m}</p>
          ))}
          {edit && (
            <a class={aside} href={edit}>
              {t.edit}
            </a>
          )}
          <a class={aside} href={links.issues}>
            {i18n._(msg`Report an issue`)}
          </a>
        </div>
      )}
    </Fragment>
  </PageShell>
</Base>

<script>
  document.querySelectorAll<HTMLElement>(".docs-content :is(h2, h3)[id]").forEach((h) => {
    const a = document.createElement("a")
    a.href = `#${h.id}`
    a.className = "heading-anchor"
    a.setAttribute("aria-hidden", "true")
    a.tabIndex = -1
    a.textContent = "#"
    h.append(a)
  })
  const article = document.querySelector<HTMLElement>(".docs-content")
  const labels: Record<string, string> = {
    sh: "Shell",
    bash: "Shell",
    yaml: "YAML",
    yml: "YAML",
    json: "JSON",
    nginx: "nginx",
    go: "Go",
    swift: "Swift",
    kotlin: "Kotlin",
    html: "HTML",
    js: "JavaScript",
    ts: "TypeScript",
    sql: "SQL",
  }
  article?.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
    const frame = document.createElement("div")
    frame.className = "code-frame"
    const bar = document.createElement("div")
    bar.className = "code-bar"
    const lang = pre.dataset.language ?? ""
    const name = document.createElement("span")
    name.textContent = labels[lang] ?? (lang === "plaintext" ? "" : lang)
    const button = document.createElement("button")
    button.type = "button"
    button.textContent = article.dataset.copy ?? "Copy"
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.innerText)
      button.textContent = article.dataset.copied ?? "Copied"
      setTimeout(() => (button.textContent = article.dataset.copy ?? "Copy"), 1400)
    })
    bar.append(name, button)
    pre.replaceWith(frame)
    frame.append(bar, pre)
  })
</script>
