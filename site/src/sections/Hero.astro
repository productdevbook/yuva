---
import type { HomeCopy } from "@/copy/home"
import type { Locale } from "@/lib/routes"
import StartCards from "@/ui/StartCards.astro"

interface Props {
  t: HomeCopy["hero"]
  locale: Locale
}

const { t, locale } = Astro.props
const button = "inline-flex h-11 items-center rounded-lg px-5 text-[15px] font-medium"
---

<div
  role="note"
  class="mb-12 flex items-start gap-3 rounded-[10px] border border-rule bg-paper-deep px-3.5 py-3 text-sm leading-[21px] text-ink-2"
>
  <svg class="mt-0.5 size-[18px] shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
    <circle cx="8" cy="8" r="6.5" stroke-width="1.3"></circle>
    <path d="M8 7.2v4M8 4.8v.01" stroke-width="1.5" stroke-linecap="round"></path>
  </svg>
  <p class="flex-1">
    <b class="font-semibold text-ink">{t.beta}.</b>
    {t.betaBody}
    <a class="font-medium text-ink underline underline-offset-4" href={t.releasesHref}>
      {t.releases}
    </a>
  </p>
</div>

<section id="overview" aria-labelledby="hero-title">
  <p class="mb-4 flex flex-wrap items-center gap-2 font-mono text-xs tracking-[0.04em] text-ink-soft uppercase">
    {t.eyebrow.map((e, i) => (
      <>
        {i > 0 && (
          <span class="text-rule-strong" aria-hidden="true">
            ·
          </span>
        )}
        <span class:list={[i === t.eyebrow.length - 1 && "text-ink"]}>{e}</span>
      </>
    ))}
  </p>
  <h1
    id="hero-title"
    class="max-w-[760px] text-[36px] leading-[40px] font-semibold tracking-[-0.035em] sm:text-[52px] sm:leading-[56px]"
  >
    {t.title}
  </h1>
  <p class="mt-5 max-w-[640px] text-[17px] leading-7 text-ink-soft sm:text-[19px] sm:leading-[30px]">{t.lead}</p>
  <div class="mt-8 flex flex-wrap items-center gap-2.5">
    <a class:list={[button, "bg-brand text-white"]} href={t.signUpHref}>
      {t.signUp}
    </a>
    <a class:list={[button, "border border-rule-strong hover:bg-paper-deep"]} href={t.quickStartHref}>
      {t.install}
    </a>
    <div class="flex min-h-11 max-w-full min-w-0 items-center gap-2.5 rounded-lg border border-rule bg-paper-deep py-1.5 ps-3.5 pe-1">
      <code class="min-w-0 font-mono text-[13px] break-all text-ink" dir="ltr">
        {t.pull}
      </code>
      <button
        type="button"
        class="h-7 shrink-0 cursor-pointer rounded-md px-2.5 text-[13px] text-ink-2 hover:bg-rule-soft hover:text-ink"
        data-copy-text={t.pull}
        data-copied={t.copied}
      >
        {t.copy}
      </button>
    </div>
  </div>
  <StartCards t={t} locale={locale} class="mt-8 max-w-[760px]" />
  <p class="mt-3 text-sm text-ink-soft">
    {t.haveAccount}
    <a class="font-medium text-ink underline underline-offset-4" href={t.logInHref}>
      {t.logIn}
    </a>
  </p>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((b) => {
    const label = b.textContent
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copyText ?? "")
      } catch {
        return
      }
      b.textContent = b.dataset.copied ?? label
      setTimeout(() => (b.textContent = label), 1400)
    })
  })
</script>
