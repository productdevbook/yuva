---
import type { HomeCopy } from "@/copy/home"
import type { Locale } from "@/lib/routes"
import { links, VERSION } from "@/lib/routes"
import type { Shots } from "@/lib/shots"
import GitHubIcon from "@/ui/GitHubIcon.astro"
import Lucide from "@/ui/Lucide.astro"
import Shot from "@/ui/Shot.astro"

interface Props {
  t: HomeCopy["hero"]
  shots: Shots
  locale: Locale
}

const { t, shots: s } = Astro.props
const appUrl = import.meta.env.PUBLIC_APP_URL
const button =
  "inline-flex h-10 items-center gap-2 rounded-full px-4 text-sm font-medium transition-colors sm:h-11 sm:px-5 sm:text-[0.95rem]"
const callout = "pointer-events-none absolute z-10 hidden -translate-y-1/2 items-center min-[90rem]:flex"
const card = "flex items-center gap-2 rounded-xl border border-rule bg-sheet px-3 py-2 text-sm whitespace-nowrap shadow-paper"
const line = "h-px w-4 bg-rule-strong"
const dot = "size-1.5 shrink-0 rounded-full bg-ink-faint"
---

<section class="overflow-x-clip" aria-labelledby="hero-title">
  <div class="mx-auto max-w-6xl px-5 pt-8 sm:px-8 sm:pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <a
        class="inline-flex max-w-full items-center gap-2 rounded-full border border-rule py-1 ps-1 pe-3 text-sm text-ink-soft transition-colors hover:border-rule-strong hover:text-ink"
        href={links.release}
      >
        <span class="rounded-full bg-brand-wash px-2 py-0.5 font-mono text-xs font-medium text-brand">{VERSION}</span>
        <span class="truncate sm:hidden">{t.releaseShort}</span>
        <span class="truncate max-sm:hidden">{t.release}</span>
        <span aria-hidden="true">→</span>
      </a>
      <h1 id="hero-title" class="mt-5 text-[clamp(2.15rem,1.2rem+4vw,4.5rem)] sm:mt-6 leading-[1.03] font-semibold tracking-[-0.035em] text-balance">
        {t.title}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-[0.95rem] leading-normal text-pretty text-ink-soft sm:mt-6 sm:text-lg sm:leading-relaxed">{t.lead}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:mt-8 sm:gap-3">
        <a class:list={[button, "bg-signal text-white hover:bg-signal/90"]} href={appUrl ?? t.quickStartHref}>
          {appUrl ? t.signUp : t.quickStart}
        </a>
        <a class:list={[button, "border border-rule-strong hover:border-ink/40 hover:bg-paper-deep"]} href={links.repo}>
          <GitHubIcon />
          {t.github}
        </a>
        {
          appUrl && (
            <a class="inline-flex h-9 items-center px-2 text-sm sm:h-11 sm:text-[0.95rem] font-medium text-ink-soft underline-offset-4 transition-colors hover:text-ink hover:underline" href={t.quickStartHref}>
              {t.selfHost}
              <span class="ms-1.5" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
      <p class="mt-3 text-xs text-ink-faint sm:mt-5 sm:text-sm">{appUrl ? t.tagsHosted : t.tags}</p>
    </div>

    <div class="relative mt-8 sm:mt-16">
      <div
        class="pointer-events-none absolute inset-x-0 -top-16 h-2/3 bg-[radial-gradient(50%_60%_at_50%_40%,var(--color-brand-wash),transparent)]"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-sm:max-w-[316px]">
        <div class="rounded-[1.25rem] border border-rule bg-paper-deep p-2 shadow-paper max-sm:rounded-[2.4rem]">
          <div class="overflow-hidden rounded-[0.9rem] border border-rule max-sm:rounded-[2rem]">
            <Shot
              light={s.thread.light}
              dark={s.thread.dark}
              alt={t.shotAlt}
              widths={[720, 1080, 1440, 2160, 2880]}
              sizes="(min-width: 1180px) 1104px, calc(100vw - 48px)"
              small={{ light: s.phoneThread.light, dark: s.phoneThread.dark, widths: [390, 585, 780], sizes: "300px" }}
              eager
            />
          </div>
        </div>
        <div class:list={[callout, "end-[calc(100%-0.5rem)] top-[23.5%]"]} aria-hidden="true">
          <span class={card}>
            <Lucide name="mail" class="text-ink-soft" />
            <span class="font-medium">{t.badges.email}</span>
          </span>
          <span class={line}></span>
          <span class={dot}></span>
        </div>
        <div class:list={[callout, "end-[calc(100%-0.5rem)] top-[46.5%]"]} aria-hidden="true">
          <span class={card}>
            <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
            <span class="flex flex-col leading-tight">
              <span class="font-medium">{t.badges.live}</span>
              <span class="text-xs text-ink-faint">{t.badges.liveNote}</span>
            </span>
          </span>
          <span class={line}></span>
          <span class={dot}></span>
        </div>
        <div class:list={[callout, "start-[calc(100%-0.5rem)] top-[66%]"]} aria-hidden="true">
          <span class={dot}></span>
          <span class={line}></span>
          <span class={card}>
            <Lucide name="sparkles" class="text-brand" />
            <span class="flex flex-col leading-tight">
              <span class="font-medium">{t.badges.draft}</span>
              <span class="text-xs text-ink-faint">{t.badges.draftNote}</span>
            </span>
          </span>
        </div>
      </div>
    </div>

    <ul class="mt-10 flex flex-wrap justify-center gap-2 sm:mt-12" aria-label={t.channelsLabel}>
      {
        t.channels.map((c) => (
          <li>
            <a
              class="flex h-10 items-center gap-2 rounded-full border border-rule bg-sheet px-4 text-sm transition-colors hover:border-rule-strong hover:bg-paper-deep"
              href={c.href}
            >
              <Lucide name={c.icon} class="text-ink-soft" />
              <span class="font-medium">{c.label}</span>
              {c.note && <span class="text-ink-faint">{c.note}</span>}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex flex-col gap-3 border-t border-rule py-6 sm:flex-row sm:items-center sm:gap-8">
      <p class="shrink-0 text-xs font-medium tracking-wide text-ink-faint uppercase">{t.worksWith}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
        {t.stack.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </div>
</section>
