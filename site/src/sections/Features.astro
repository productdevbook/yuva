---
import type { HomeCopy } from "@/copy/home"

interface Props {
  t: HomeCopy
}

const { t } = Astro.props
const byId = Object.fromEntries(t.features.items.map((f) => [f.id, f]))
const rows = t.features.items.filter((f) => !["inbox", "channels", "developers", "self-hosting"].includes(f.id))
const developers = byId["developers"]!
const selfHosting = byId["self-hosting"]!
const h2 = "mt-[72px] mb-2 scroll-mt-6 text-[22px] leading-7 font-semibold tracking-[-0.01em]"
const lead = "mb-5 max-w-[680px] text-[15px] leading-6 text-ink-soft"
const more = "text-sm font-medium text-ink underline-offset-4 hover:underline"
---

<section aria-labelledby="channels">
  <h2 id="channels" class={h2}>
    {t.channels.title}
  </h2>
  <p class={lead}>{t.channels.lead}</p>
  <ul class="grid [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))] overflow-hidden rounded-[10px] border border-rule">
    {t.channels.cells.map((c) => (
      <li class="-me-px -mb-px border-e border-b border-rule-soft">
        <a class="flex h-full flex-col gap-2 p-[18px] hover:bg-paper-deep" href={c.href}>
          <span class="text-[15px] font-semibold">{c.name}</span>
          <code class="font-mono text-xs text-brand" dir="ltr">
            {c.code}
          </code>
          <span class="text-[13px] leading-[19px] text-ink-soft">{c.text}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="parts">
  <h2 id="parts" class={h2}>
    {t.parts.title}
  </h2>
  <p class={lead}>{t.parts.lead}</p>
  <div class="border-t border-rule-soft">
    {rows.map((f) => (
      <div id={f.id} class="flex scroll-mt-6 flex-wrap gap-x-6 gap-y-1.5 border-b border-rule-soft py-[18px]">
        <h3 class="flex-[0_0_200px] text-[15px] font-semibold">{f.title}</h3>
        <p class="flex-[1_1_320px] text-[15px] leading-6 text-ink-soft">
          {f.body}{" "}
          <a class={more} href={f.href}>
            {f.link ?? t.features.guide} →
          </a>
        </p>
      </div>
    ))}
  </div>
</section>

<section aria-labelledby="developers">
  <h2 id="developers" class={h2}>
    {developers.title}
  </h2>
  <p class={lead}>{developers.body}</p>
  <div class="overflow-hidden rounded-[10px] border border-rule">
    <div class="flex h-10 items-center gap-4 border-b border-rule px-4 font-mono text-[13px] text-ink">curl</div>
    <pre
      class="m-0 overflow-x-auto bg-paper-deep px-[18px] py-4 font-mono text-[13px] leading-[21px]"
      dir="ltr"
    >{t.build.curl}</pre>
  </div>
  <dl class="mt-4 grid [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))] gap-x-6 gap-y-2 text-sm">
    {developers.points.map((p) => (
      <div>
        <dt class="font-semibold">{p.term}</dt>
        <dd class="text-ink-soft">{p.text}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-4">
    <a class={more} href={developers.href}>
      {developers.link} →
    </a>
  </p>
</section>

<section aria-labelledby="self-hosting">
  <h2 id="self-hosting" class={h2}>
    {selfHosting.title}
  </h2>
  <p class={lead}>{selfHosting.body}</p>
  <ul class="grid [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))] gap-4">
    {selfHosting.points.map((p) => (
      <li class="rounded-[10px] border border-rule p-[18px]">
        <p class="text-[15px] font-semibold">{p.term}</p>
        <p class="mt-1.5 text-sm leading-[21px] text-ink-soft">{p.text}</p>
      </li>
    ))}
  </ul>
  <p class="mt-4">
    <a class={more} href={selfHosting.href}>
      {t.hero.quickStart} →
    </a>
  </p>
</section>
