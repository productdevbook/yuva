---
import { render } from "astro:content"
import { homeCopy } from "@/copy/home"
import { blogCopy } from "@/copy/pages"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { isoDay, listFor, localesOf, minutes, slugOf, type Post } from "@/lib/blog"
import { quickStart } from "@/lib/docs"
import { absolute, bcp47, blog, post, type Locale } from "@/lib/routes"
import Logo from "@/ui/Logo.astro"
import PostCover from "@/ui/PostCover.astro"
import StartCards from "@/ui/StartCards.astro"
import Stop from "@/ui/Stop.astro"

interface Props {
  entry: Post
  locale: Locale
}

const { entry, locale } = Astro.props
const slug = slugOf(entry.id)
const i18n = i18nFor(locale)
const t = blogCopy(i18n)
const hero = homeCopy(i18n, await quickStart(locale)).hero
const { Content, headings } = await render(entry)
const toc = headings.filter((h) => h.depth === 2)
const others = (await listFor(locale)).filter((p) => p.slug !== slug).slice(0, 3)
const available = await localesOf(slug)
const paths = Object.fromEntries(
  Object.entries(blog).map(([l, rel]) => [l, available.includes(l as Locale) ? post(slug, l as Locale) : rel])
) as typeof blog
const date = new Intl.DateTimeFormat(bcp47[locale], { dateStyle: "long", timeZone: "UTC" })
const url = absolute(post(slug, locale))
const share = [
  {
    label: "X",
    href: `https://x.com/intent/post?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(url)}`,
  },
  { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
]
const pill =
  "inline-flex h-9 items-center rounded-full border border-rule-strong px-4 text-sm font-medium transition-colors hover:border-ink/40 hover:bg-paper-deep"
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.date.toISOString(),
    author: { "@type": "Person", name: entry.data.author },
    image: absolute(`/og/blog/${entry.id}.png`),
    inLanguage: bcp47[locale],
    mainEntityOfPage: url,
  },
]
---

<Base
  locale={locale}
  title={`${entry.data.title} · Yuva`}
  description={entry.data.description}
  paths={paths}
  translated={false}
  type="article"
  image={`/og/blog/${entry.id}.png`}
  jsonLd={jsonLd}
>
  <article>
    <header class="px-5 pt-12 pb-16 text-center sm:px-8 sm:pt-16">
      <a class="text-sm text-ink-soft transition-colors hover:text-ink" href={blog[locale]}>
        ← {t.back}
      </a>
      <p class="mt-8 text-sm text-ink-faint">
        <time datetime={isoDay(entry.data.date)}>{date.format(entry.data.date)}</time>
        <span> · {t.readTime(minutes(entry))}</span>
      </p>
      <h1 class="mx-auto mt-4 max-w-3xl text-[clamp(2.3rem,1.5rem+3vw,3.6rem)] leading-[1.05] font-semibold tracking-[-0.035em]">
        {entry.data.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{entry.data.description}</p>
      <p class="mt-6 inline-flex items-center gap-2.5 text-sm">
        <Logo size={28} />
        <span class="font-medium">{entry.data.author}</span>
      </p>
    </header>

    <Stop flush>
      <PostCover title={entry.data.title} />
    </Stop>

    <Stop>
      <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
        <div class="min-w-0">
          <div class="prose-yuva prose max-w-none prose-headings:scroll-mt-24 prose-headings:tracking-tight prose-h2:mt-12 prose-a:font-medium prose-a:underline-offset-4 prose-code:before:content-none prose-code:after:content-none prose-li:my-1.5">
            <Content />
          </div>

          <div class="mt-14 flex flex-wrap items-center gap-2 border-t border-rule pt-8">
            <span class="me-2 text-sm font-medium text-ink-faint">{t.share}</span>
            <button type="button" class={pill} data-copy-link={url} data-done={t.copied}>
              {t.copyLink}
            </button>
            {share.map((s) => (
              <a class={pill} href={s.href} rel="noopener" target="_blank">
                {s.label}
              </a>
            ))}
          </div>

          <div class="mt-8 flex items-center gap-4 border border-rule p-5">
            <Logo size={44} />
            <div>
              <p class="font-semibold">{entry.data.author}</p>
              <p class="text-sm text-ink-soft">{t.role}</p>
            </div>
          </div>
        </div>

        {toc.length > 0 && (
          <nav class="hidden lg:block" aria-labelledby="toc-title">
            <div class="sticky top-24">
              <p id="toc-title" class="text-sm font-semibold">
                {t.onThisPage}
              </p>
              <ol class="mt-3 grid gap-2 border-s border-rule text-sm">
                {toc.map((h) => (
                  <li>
                    <a
                      class="-ms-px block border-s border-transparent ps-4 text-ink-soft transition-colors hover:border-ink hover:text-ink"
                      href={`#${h.slug}`}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        )}
      </div>
    </Stop>
  </article>

  <Stop labelledby="try-title" tone="deep">
    <div class="mx-auto max-w-5xl">
      <h2 id="try-title" class="text-2xl font-semibold tracking-tight">
        {t.tryTitle}
      </h2>
      <p class="mt-2 text-ink-soft">{t.tryBody}</p>
      <StartCards t={hero} locale={locale} class="mt-6" />
    </div>
  </Stop>

  {others.length > 0 && (
    <Stop labelledby="more-title" label={t.more} headed flush>
      <ul class="-me-px -mb-px grid sm:grid-cols-3">
        {others.map((p) => (
          <li class="min-w-0 border-e border-b border-rule">
            <a class="group block p-5 sm:p-6" href={post(p.slug, p.lang)} hreflang={p.lang} lang={p.lang}>
              <PostCover title={p.entry.data.title} size="sm" />
              <p class="mt-4 text-sm text-ink-faint">{date.format(p.entry.data.date)}</p>
              <h3 class="mt-1 font-semibold group-hover:text-brand">{p.entry.data.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </Stop>
  )}
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((el) => {
    el.addEventListener("click", async () => {
      await navigator.clipboard.writeText(el.dataset.copyLink!)
      const before = el.textContent
      el.textContent = el.dataset.done ?? ""
      setTimeout(() => (el.textContent = before), 1400)
    })
  })
</script>
