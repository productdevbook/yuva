---
import { msg } from "@lingui/core/macro"
import { Code } from "astro:components"
import Diagram from "@/components/Diagram.astro"
import Shot from "@/components/Shot.astro"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { absolute, home, links, type Locale } from "@/lib/routes"
import { shots } from "@/lib/shots"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const i18n = i18nFor(locale)
const s = shots(locale)

const title = i18n._(msg`Yuva: one open-source inbox for e-mail, live chat and in-app messages`)
const description = i18n._(
  msg`Yuva brings support e-mail, live chat and in-app conversations from all of your products into one shared inbox. Open source, self-hosted, one Go binary with Postgres.`
)

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Yuva",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Linux, Docker",
    description,
    url: absolute(home[locale]),
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    codeRepository: links.repo,
    softwareVersion: "0.0.1",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
]

const problems = [
  {
    title: i18n._(msg`Support mail is scattered`),
    body: i18n._(
      msg`Every product has its own support address, forwarded into someone's personal mailbox. Nobody can see who answered, threads break, and auto-replies bounce back and forth.`
    ),
  },
  {
    title: i18n._(msg`Live chat only where someone paid for it`),
    body: i18n._(
      msg`One site has a chat widget on a per-seat plan, the others only a contact form. Visitors who leave before anyone answers are simply gone.`
    ),
  },
  {
    title: i18n._(msg`In-app messages sit in a closed box`),
    body: i18n._(
      msg`Feedback from the mobile apps goes to a third-party SDK, an e-mail form or nowhere at all. Your users' conversations live in someone else's cloud.`
    ),
  },
]

const steps = [
  {
    title: i18n._(msg`Connect your products`),
    body: i18n._(msg`Create one inbox per product and give it channels: a support address, a chat widget, an app key, an API.`),
  },
  {
    title: i18n._(msg`Answer from one panel`),
    body: i18n._(
      msg`Conversations from every channel share one list, one thread view and one set of tools. Members see only the inboxes they were given.`
    ),
  },
  {
    title: i18n._(msg`Let your backend react`),
    body: i18n._(
      msg`Signed webhooks tell your backend about new messages, so it can push a reply to a closed app with the keys it already has.`
    ),
  },
]

const email = [
  i18n._(msg`Threads follow In-Reply-To and References, and replies find their conversation even when a mail client drops the headers.`),
  i18n._(msg`Quotes and signatures are stripped from what you read; the full text, sanitized HTML and the original message are kept.`),
  i18n._(msg`Catch-all addresses per domain, and local+tag addresses that reach their channel.`),
  i18n._(msg`Loop protection: auto-replies, bulk mail and Yuva's own messages never trigger another automatic message.`),
  i18n._(msg`Bounces from delivery reports and Amazon SES mark an address undeliverable.`),
]

const chat = [
  i18n._(msg`Shadow DOM: your styles stay out, the widget's styles stay in.`),
  i18n._(msg`Presence, typing and read receipts in live inboxes; an expected reply time in async ones.`),
  i18n._(msg`When the visitor has left, unread replies follow them by e-mail, and their answer continues the same conversation.`),
  i18n._(msg`Anonymous visitors, or signed-in users through an identity token from your backend.`),
  i18n._(msg`English and Turkish, left-to-right and right-to-left.`),
]

const inApp = [
  i18n._(msg`Feedback with a category (bug, idea, praise, other), screenshots and device details: app version, build, system, device and screen.`),
  i18n._(msg`The panel filters feedback by category and counts what is still open.`),
  i18n._(msg`Users write as themselves through a short-lived token signed by your backend; Yuva never sees your user database.`),
  i18n._(msg`Push stays yours: Yuva sends a webhook, your backend sends the notification through APNs or FCM.`),
]

const panel = [
  { title: i18n._(msg`Shared inbox`), body: i18n._(msg`All, mine, unassigned, per inbox and per label; open, pending, snoozed and closed.`) },
  { title: i18n._(msg`Assignment`), body: i18n._(msg`Assign conversations, set priority and hand over; every change is recorded in the thread.`) },
  { title: i18n._(msg`Internal notes`), body: i18n._(msg`Notes sit next to the replies and never reach the contact.`) },
  { title: i18n._(msg`Labels and canned replies`), body: i18n._(msg`Label conversations and insert saved answers by typing / in the composer.`) },
  { title: i18n._(msg`Search`), body: i18n._(msg`Full-text search across conversations, built on Postgres.`) },
  { title: i18n._(msg`Realtime`), body: i18n._(msg`New messages, typing and teammates' changes appear live over WebSocket.`) },
  { title: i18n._(msg`Notifications`), body: i18n._(msg`Install the panel as an app and get Web Push on phones and desktops, with e-mail as a fallback.`) },
  { title: i18n._(msg`Keyboard first`), body: i18n._(msg`Move through the list, reply, write notes and search without reaching for the mouse.`) },
  { title: i18n._(msg`Contact context`), body: i18n._(msg`Name, addresses, your own user id, attributes such as plan or app version, and earlier conversations.`) },
  { title: i18n._(msg`No passwords`), body: i18n._(msg`Sign in with an e-mailed code or a passkey. There is no open sign-up; everyone is invited.`) },
  { title: i18n._(msg`Roles and access`), body: i18n._(msg`Owners, admins and agents; agents see only the inboxes they were given.`) },
  { title: i18n._(msg`Turkish and English`), body: i18n._(msg`The panel, widget and SDKs speak both, and every member picks their own language.`) },
]

const devFacts = [
  {
    title: i18n._(msg`OpenAPI 3.1 contract`),
    body: i18n._(msg`openapi/openapi.yaml is the source of truth: the server and the clients are generated from it, and you can generate yours in any language.`),
  },
  {
    title: i18n._(msg`Identity tokens`),
    body: i18n._(msg`Your backend signs a short-lived HS256 token for the signed-in user. sdk/go does it in one call; any JWT library works.`),
  },
  {
    title: i18n._(msg`Standard Webhooks`),
    body: i18n._(msg`Conversation, message, feedback and contact events, signed and retried for about a day, with a delivery log and redelivery.`),
  },
  {
    title: i18n._(msg`Your users stay yours`),
    body: i18n._(msg`Contacts are found by your own user id. When a user deletes their account, one API call removes them with everything they wrote.`),
  },
]

const snippets = [
  {
    id: "web",
    title: i18n._(msg`Website: the chat widget`),
    lang: "html",
    code: `<script src="https://support.example.com/yuva.js" defer></script>
<yuva-chat channel="yuva_pk_xxxxxxxxxxxxxxxx"></yuva-chat>`,
  },
  {
    id: "go",
    title: i18n._(msg`Your backend: an identity token in Go`),
    lang: "go",
    code: `import "github.com/productdevbook/yuva/sdk/go/identity"

token, err := identity.Sign(os.Getenv("YUVA_IDENTITY_SECRET"), identity.Claims{
	Subject:       user.ID,
	Email:         user.Email,
	EmailVerified: user.EmailConfirmed,
	Name:          user.Name,
	Attrs:         map[string]any{"plan": user.Plan},
})`,
  },
  {
    id: "swift",
    title: i18n._(msg`iOS: YuvaKit and SwiftUI`),
    lang: "swift",
    code: `import YuvaKit

let yuva = YuvaClient(configuration: YuvaConfiguration(
    serverURL: URL(string: "https://support.example.com")!,
    channelKey: "yuva_pk_xxxxxxxxxxxxxxxx",
    identityToken: { try await MyAPI.yuvaIdentityToken() }
))

YuvaConversationsView(client: yuva, openConversationId: $openConversationId)`,
  },
  {
    id: "kotlin",
    title: i18n._(msg`Android: Kotlin and Compose`),
    lang: "kotlin",
    code: `val yuva = YuvaClient(
    context,
    YuvaConfiguration(
        serverUrl = "https://support.example.com",
        channelKey = "yuva_pk_xxxxxxxxxxxxxxxx",
        identityToken = { myApi.yuvaIdentityToken() },
    ),
)

YuvaConversationsView(client = yuva, openConversationId = conversationId, onClose = { finish() })`,
  },
  {
    id: "webhook",
    title: i18n._(msg`Webhooks: verify the signature`),
    lang: "go",
    code: `import "github.com/productdevbook/yuva/sdk/go/webhook"

body, _ := io.ReadAll(io.LimitReader(r.Body, 1<<20))
if err := webhook.Verify(os.Getenv("YUVA_WEBHOOK_SECRET"), r.Header, body, 5*time.Minute); err != nil {
	http.Error(w, "bad signature", http.StatusUnauthorized)
	return
}`,
  },
]

const hosting = [
  { title: i18n._(msg`One Docker image`), body: i18n._(msg`Server, panel and widget scripts in one image that runs as a non-root user. Every operator command runs from it too.`) },
  { title: i18n._(msg`Postgres 16 or newer`), body: i18n._(msg`Everything lives in the database, the job queue and realtime fan-out included. No Redis, no separate workers.`) },
  { title: i18n._(msg`Files where you want them`), body: i18n._(msg`Attachments and original e-mails on a local volume or in any S3-compatible storage: S3, R2, MinIO.`) },
  { title: i18n._(msg`Easy to watch`), body: i18n._(msg`JSON logs, Prometheus metrics, and health and readiness endpoints for your monitoring.`) },
]

const install = [
  {
    title: i18n._(msg`Build the image`),
    body: i18n._(msg`Clone the repository and build the image from its Dockerfile.`),
    code: `git clone https://github.com/productdevbook/yuva.git && cd yuva
docker build -f deploy/Dockerfile --build-arg VERSION=0.0.1 -t yuva:0.0.1 .`,
  },
  {
    title: i18n._(msg`Write compose.yaml and .env`),
    body: i18n._(msg`Copy both files from the install guide: Postgres, your public URL, a master key, an ingress secret and an SMTP account.`),
    link: { href: links.quickStart, label: i18n._(msg`Open the install guide`) },
  },
  {
    title: i18n._(msg`Start it`),
    body: i18n._(msg`Add a Web Push key pair, start the stack, and check that it is ready. Migrations run on start.`),
    code: `docker run --rm yuva:0.0.1 vapid-keys >> .env
docker compose up -d
curl -s http://127.0.0.1:8080/readyz     # {"status":"ok"}`,
  },
  {
    title: i18n._(msg`Create the first owner`),
    body: i18n._(msg`There is no open sign-up. Create the workspace and its owner, sign in with the code that arrives by e-mail, and invite your team.`),
    code: `docker compose exec yuva /yuva bootstrap --email you@example.com --workspace "Example" --name "Your Name"`,
  },
]

const security = [
  {
    title: i18n._(msg`Untrusted mail stays inert`),
    body: i18n._(msg`Incoming HTML is sanitized and shown in a sandboxed frame under a strict Content Security Policy; remote images wait until a member loads them.`),
  },
  {
    title: i18n._(msg`Signed ingress`),
    body: i18n._(msg`Inbound mail must carry an HMAC signature with a fresh timestamp, and Amazon SNS notifications are checked against AWS's signing certificate.`),
  },
  {
    title: i18n._(msg`No requests into your network`),
    body: i18n._(msg`Webhook URLs, SMTP hosts and push endpoints are resolved and refused when they point at private, loopback or cloud metadata addresses.`),
  },
  {
    title: i18n._(msg`Origin checks`),
    body: i18n._(msg`Panel requests that change data must come from the panel's own origin, and the widget answers only the origins a chat channel allows.`),
  },
  {
    title: i18n._(msg`Passkeys and encrypted secrets`),
    body: i18n._(msg`One-time codes with attempt limits, and passkeys. SMTP passwords and signing secrets are encrypted with AES-256-GCM under your master key.`),
  },
  {
    title: i18n._(msg`Data you can delete`),
    body: i18n._(msg`Delete a contact, from the panel or by your own user id, and their conversations, messages and files go with them. Nothing goes to third parties except what a channel is set up to send.`),
  },
]

const licensing = [
  {
    tag: "AGPL-3.0",
    title: i18n._(msg`Server and panel`),
    body: i18n._(msg`Use it, change it, run it. If you run a modified Yuva as a network service for other people, you offer them its source.`),
  },
  {
    tag: "MIT",
    title: i18n._(msg`SDKs and API contract`),
    body: i18n._(msg`The widget, the Swift, Kotlin and Go SDKs and the OpenAPI contract are MIT, so they ship inside closed-source apps and store builds without obligations.`),
  },
  {
    tag: "CLA",
    title: i18n._(msg`Contributor License Agreement`),
    body: i18n._(msg`Contributions are made under a CLA, so the project can also offer a commercial license to organisations that cannot use the AGPL. Code published under the AGPL never moves to a more restrictive license.`),
  },
  {
    tag: "™",
    title: i18n._(msg`The name and logo`),
    body: i18n._(msg`The licenses cover the code, not the name. Say that you use or build on Yuva; give a fork you publish or host for others its own name.`),
  },
]

const done = i18n._(msg`Done`)
const roadmap = [
  { state: "done", title: i18n._(msg`Foundation`), body: i18n._(msg`Go server, OpenAPI contract, migrations, job queue and CI.`) },
  { state: "done", title: i18n._(msg`Core model and sign-in`), body: i18n._(msg`Workspaces, roles, inboxes, channels, contacts, conversations, API keys, codes and passkeys.`) },
  { state: "done", title: i18n._(msg`Team panel`), body: i18n._(msg`List, search, threads, notes, labels, canned replies, realtime updates, Turkish and English.`) },
  { state: "done", title: i18n._(msg`E-mail`), body: i18n._(msg`Inbound through a Worker or any MTA, threading, quote stripping, SMTP, loop protection and bounces.`) },
  { state: "done", title: i18n._(msg`Web widget`), body: i18n._(msg`Live chat, embedded threads, identity tokens, presence and e-mail continuity.`) },
  { state: "done", title: i18n._(msg`Mobile SDKs, feedback and webhooks`), body: i18n._(msg`iOS and Android, feedback with device details, Standard Webhooks.`) },
  { state: "done", title: i18n._(msg`Member notifications`), body: i18n._(msg`Installable panel, Web Push, preferences per event and inbox, e-mail fallback.`) },
  { state: "now", title: i18n._(msg`First real use`), body: i18n._(msg`Running real support for a set of products on Yuva alone.`) },
  { state: "next", title: i18n._(msg`First public release, 0.0.1`), body: i18n._(msg`A tagged release and its Docker image, and a security review of sign-in, client sessions, ingress and attachment handling.`) },
]
const stateLabel: Record<string, string> = { done, now: i18n._(msg`In progress`), next: i18n._(msg`Next`) }

const faq = [
  {
    q: i18n._(msg`Is Yuva ready for production?`),
    a: i18n._(msg`Not yet. It is pre-alpha: the API and the database schema can change without migration paths, and the code has not had a security review. Try it with test data and watch the repository for the first release.`),
  },
  {
    q: i18n._(msg`How is it different from hosted support tools?`),
    a: i18n._(msg`Yuva is built for one team that runs many products: each product is an inbox with its own branding, channels and members, all answered from one panel. You host it yourself, there is no per-seat pricing, and it stays small: one binary and Postgres.`),
  },
  {
    q: i18n._(msg`What do I need to run it?`),
    a: i18n._(msg`A host with Docker, Postgres 16 or newer, an SMTP account for sign-in codes and notifications, and a host name with TLS behind a reverse proxy that passes WebSockets. Attachments go on a volume or into an S3-compatible bucket.`),
  },
  {
    q: i18n._(msg`Does Yuva receive e-mail itself?`),
    a: i18n._(msg`Yuva does not listen for SMTP. Mail reaches it through the included Cloudflare Email Worker, through the yuva ingest-email command from Postfix or any other MTA, or as a signed HTTP request.`),
  },
  {
    q: i18n._(msg`Does Yuva send push notifications to my app?`),
    a: i18n._(msg`Your backend does. Yuva sends a signed message.created webhook that says whether the user is online; your backend sends the push through APNs or FCM with the keys it already has, and the SDKs open the right conversation when it is tapped. Your team gets Web Push from the panel.`),
  },
  {
    q: i18n._(msg`Can a closed-source app use the SDKs?`),
    a: i18n._(msg`Yes. The SDKs and the API contract are MIT. Only the server and the panel are AGPL, and that matters when you modify them and offer them to others as a network service.`),
  },
  {
    q: i18n._(msg`Which languages does it speak?`),
    a: i18n._(msg`The panel, the widget and the mobile SDKs ship in English and Turkish. Every inbox has its own default language, and the widget also handles right-to-left layouts.`),
  },
  {
    q: i18n._(msg`Can I host it for my customers?`),
    a: i18n._(msg`Inside your own company, modified or not, yes. Offering a hosted service or a product under the Yuva name needs written permission; a renamed fork that keeps the AGPL is always allowed.`),
  },
]
---

<Base locale={locale} title={title} description={description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      <p class="eyebrow">
        <span class="dot" aria-hidden="true"></span>
        {i18n._(msg`Open source · Self-hosted · Pre-alpha`)}
      </p>
      <h1 id="hero-title">{i18n._(msg`One inbox for every product you run.`)}</h1>
      <p class="lead hero-lead">
        {
          i18n._(
            msg`Yuva brings support e-mail, live chat and in-app conversations from all of your products into one shared inbox for your team. It is open source, you host it yourself, and it runs as one Go binary with Postgres.`
          )
        }
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={links.repo}>{i18n._(msg`View on GitHub`)}</a>
        <a class="btn btn-ghost" href={links.quickStart}>{i18n._(msg`Read the quick start`)}</a>
      </div>
      <p class="hero-note">{i18n._(msg`AGPL-3.0 server, MIT SDKs. Your conversations stay on your servers.`)}</p>
    </div>
    <div class="wrap hero-shot">
      <div class="window">
        <div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <Shot
          light={s.thread.light}
          dark={s.thread.dark}
          alt={i18n._(
            msg`The Yuva panel: conversations from three products in one list, an in-app conversation with an internal note and a reply, and the contact's details sent by the host app.`
          )}
          widths={[720, 1080, 1440, 2160, 2880]}
          sizes="(min-width: 1240px) 1180px, calc(100vw - 32px)"
          small={{ light: s.phoneThread.light, dark: s.phoneThread.dark, widths: [390, 585, 780], sizes: "300px" }}
          eager
        />
      </div>
    </div>
  </section>

  <aside class="wrap" aria-label={i18n._(msg`Project status`)}>
    <div class="status-note">
      <strong>{i18n._(msg`Pre-alpha.`)}</strong>
      <span>
        {
          i18n._(
            msg`The API and database schema still change without migration paths, and the code has not had a security review yet. Try it, read it and tell us what breaks, but do not put real customer data in it yet.`
          )
        }
      </span>
    </div>
  </aside>

  <section class="section" id="why" aria-labelledby="why-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`Why Yuva`)}</p>
      <h2 id="why-title">{i18n._(msg`Several products means answering people in several places.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`Small teams rarely run just one product. There is an app, its website, a side project and the tool that pays the bills, and each one collects messages somewhere else.`
          )
        }
      </p>
      <div class="grid-3 problems">
        {
          problems.map((p, i) => (
            <article class="card">
              <span class="card-num" aria-hidden="true">
                0{i + 1}
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
      <p class="answer">
        {
          i18n._(
            msg`Yuva gives all of it one home: every product is an inbox, every channel lands in the same conversation model, and the whole team answers from one panel on servers you control.`
          )
        }
      </p>
    </div>
  </section>

  <section class="section section-alt" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`How it works`)}</p>
      <h2 id="how-title">{i18n._(msg`Messages come in on any channel. Your team answers in one place.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`Each message becomes part of a conversation in an inbox, and members answer from the panel. Yuva tells your backend what happened through signed webhooks, so your own apps can send their push notifications.`
          )
        }
      </p>
      <Diagram locale={locale} />
      <ol class="steps">
        {
          steps.map((st, i) => (
            <li>
              <span class="step-num" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{st.title}</h3>
              <p>{st.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="channels" aria-labelledby="channels-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`Channels`)}</p>
      <h2 id="channels-title">{i18n._(msg`Every channel, one conversation model.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`Live chat and asynchronous messaging differ only in settings. Whatever channel a conversation starts on, it looks and works the same in the panel, and each inbox chooses live or async.`
          )
        }
      </p>

      <div class="feature">
        <div class="feature-copy">
          <h3 class="feature-title"><span class="chip">{i18n._(msg`E-mail`)}</span>{i18n._(msg`E-mail done properly`)}</h3>
          <p>
            {
              i18n._(
                msg`Point a support address at Yuva through a Cloudflare Email Worker, any MTA or a signed HTTP request. Replies go out through each channel's own SMTP account: SES, Postmark or your own relay.`
              )
            }
          </p>
          <ul class="ticks">{email.map((e) => <li>{e}</li>)}</ul>
          <a class="more" href={links.email}>{i18n._(msg`E-mail guide`)}</a>
        </div>
        <div class="feature-media mail-card" aria-hidden="true">
          <div class="mail-head">
            <span class="mail-from">{i18n._(msg`Amara Okafor`)}</span>
            <span class="mail-subject">{i18n._(msg`Custom domain still shows as unverified`)}</span>
          </div>
          <p class="mail-body">{i18n._(msg`I added the CNAME record two days ago, but the dashboard still says “unverified”. Is there anything else I need to do?`)}</p>
          <p class="mail-quote">{i18n._(msg`On Monday, Paperboat Support wrote: …`)}</p>
          <div class="mail-tags">
            <span>{i18n._(msg`quote hidden`)}</span>
            <span>{i18n._(msg`threaded`)}</span>
            <span>DMARC pass</span>
          </div>
        </div>
      </div>

      <div class="feature feature-flip">
        <div class="feature-copy">
          <h3 class="feature-title"><span class="chip">{i18n._(msg`Live chat`)}</span>{i18n._(msg`Live chat and embedded threads`)}</h3>
          <p>
            {
              i18n._(
                msg`One web component loaded by one script tag. Use it as a floating launcher on a website, or embed a conversation thread inside your own product's panel.`
              )
            }
          </p>
          <ul class="ticks">{chat.map((e) => <li>{e}</li>)}</ul>
          <a class="more" href={links.widget}>{i18n._(msg`Widget guide`)}</a>
        </div>
        <div class="feature-media">
          <div class="window">
            <div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <Shot
              light={s.widget.light}
              dark={s.widget.dark}
              alt={i18n._(msg`The Yuva chat widget open on a newsletter tool's website: the visitor's question and a member's reply, with the member shown online.`)}
              widths={[640, 960, 1280, 1920, 2560]}
              sizes="(min-width: 1000px) 1000px, 180vw"
              crop={{ x: 0.45, y: 0.08, w: 0.55, h: 0.92 }}
            />
          </div>
        </div>
      </div>

      <div class="feature">
        <div class="feature-copy">
          <h3 class="feature-title"><span class="chip">{i18n._(msg`In-app`)}</span>{i18n._(msg`In-app messaging and feedback`)}</h3>
          <p>
            {
              i18n._(
                msg`Native SDKs for iOS (YuvaKit, SwiftUI) and Android (Kotlin, Jetpack Compose) give your app a conversation list, threads with attachments and a feedback form, or a headless client for your own interface.`
              )
            }
          </p>
          <ul class="ticks">{inApp.map((e) => <li>{e}</li>)}</ul>
          <a class="more" href={links.mobile}>{i18n._(msg`Mobile SDK guide`)}</a>
        </div>
        <div class="feature-media inapp-media">
          <div class="window inapp-panel">
            <div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <Shot
              light={s.feedback.light}
              dark={s.feedback.dark}
              alt={i18n._(msg`A bug report in the panel with the app version, device, system and screen it came from.`)}
              widths={[640, 960, 1280, 1920, 2880]}
              sizes="(min-width: 1000px) 1200px, 220vw"
              crop={{ x: 0.445, y: 0, w: 0.33, h: 0.5 }}
            />
          </div>
          <div class="phone">
            <Shot
              light={s.ios}
              alt={i18n._(msg`The messages screen of the iOS SDK in a sample app, with a feedback thread and a conversation.`)}
              widths={[240, 360, 480]}
              sizes="(min-width: 1000px) 200px, 38vw"
            />
          </div>
        </div>
      </div>

      <div class="api-strip">
        <h3>{i18n._(msg`And an API for everything else`)}</h3>
        <p>
          {
            i18n._(
              msg`A feedback form rendered by your own backend posts to /v1/feedback with a workspace API key. Scripts create inboxes, channels and keys, and host backends look up or delete contacts by their own user id.`
            )
          }
        </p>
        <a class="more" href={links.openapi}>{i18n._(msg`API contract`)}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="panel" aria-labelledby="panel-title">
    <div class="wrap panel-layout">
      <div>
        <p class="kicker">{i18n._(msg`The team panel`)}</p>
        <h2 id="panel-title">{i18n._(msg`Built for the people who answer.`)}</h2>
        <p class="lead">
          {
            i18n._(
              msg`The panel ships inside the binary. It is fast, made for the keyboard, and works on phones as an installable app.`
            )
          }
        </p>
        <dl class="feature-list">
          {
            panel.map((f) => (
              <div>
                <dt>{f.title}</dt>
                <dd>{f.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="phone phone-large">
        <Shot
          light={s.phone.light}
          dark={s.phone.dark}
          alt={i18n._(msg`The panel on a phone: the conversation list with labels, priorities and assignees.`)}
          widths={[320, 480, 720, 1170]}
          sizes="(min-width: 1000px) 320px, 70vw"
        />
      </div>
    </div>
  </section>

  <section class="section" id="developers" aria-labelledby="dev-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`For developers`)}</p>
      <h2 id="dev-title">{i18n._(msg`Made to be embedded in your products.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`Yuva is built for teams that make their own software. Every surface has a typed contract and a small, documented integration.`
          )
        }
      </p>
      <div class="grid-4">
        {
          devFacts.map((f) => (
            <article class="card card-plain">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
      <div class="snippets">
        {
          snippets.map((sn) => (
            <figure class={`snippet snippet-${sn.id}`}>
              <figcaption>{sn.title}</figcaption>
              <Code code={sn.code} lang={sn.lang as "go"} themes={{ light: "github-light", dark: "github-dark" }} />
            </figure>
          ))
        }
      </div>
      <p class="doc-links">
        <a href={links.widget}>{i18n._(msg`Web widget`)}</a>
        <a href={links.identity}>{i18n._(msg`Identity tokens`)}</a>
        <a href={links.mobile}>{i18n._(msg`Mobile SDKs`)}</a>
        <a href={links.webhooks}>{i18n._(msg`Webhooks`)}</a>
        <a href={links.openapi}>OpenAPI</a>
      </p>
    </div>
  </section>

  <section class="section section-alt" id="self-host" aria-labelledby="host-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`Self-hosting`)}</p>
      <h2 id="host-title">{i18n._(msg`Yours to run, on one small server.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`Yuva is one Go binary and a Postgres database. The job queue, realtime events and search all live in Postgres, so there is nothing else to operate.`
          )
        }
      </p>
      <div class="grid-4">
        {
          hosting.map((f) => (
            <article class="card card-plain">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
      <ol class="install">
        {
          install.map((st, i) => (
            <li>
              <div class="install-head">
                <span class="step-num" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h3>{st.title}</h3>
                  <p>{st.body}</p>
                </div>
              </div>
              {st.code && <Code code={st.code} lang="sh" themes={{ light: "github-light", dark: "github-dark" }} />}
              {st.link && (
                <a class="more" href={st.link.href}>
                  {st.link.label}
                </a>
              )}
            </li>
          ))
        }
      </ol>
      <p class="fine">
        {
          i18n._(
            msg`Put it behind a TLS reverse proxy that passes WebSockets; Caddy works as it is. The install guide also covers nginx, backups, upgrades and every setting.`
          )
        }
        <a href={links.operations}>{i18n._(msg`Operations guide`)}</a>
      </p>
    </div>
  </section>

  <section class="section" id="security" aria-labelledby="sec-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`Security and privacy`)}</p>
      <h2 id="sec-title">{i18n._(msg`Careful with what it holds.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`A support inbox holds other people's words. Yuva is built with that in mind, and says plainly that it has not had a security review yet.`
          )
        }
      </p>
      <div class="grid-3">
        {
          security.map((f) => (
            <article class="card card-plain">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
      <p class="report">
        {i18n._(msg`Found a vulnerability? Report it privately through GitHub, not in a public issue.`)}
        <a href={links.security}>{i18n._(msg`Security policy`)}</a>
      </p>
    </div>
  </section>

  <section class="section section-warm" id="open-source" aria-labelledby="oss-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`Open source and licensing`)}</p>
      <h2 id="oss-title">{i18n._(msg`Open source, and meant to stay that way.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`Yuva uses a split license: the server stays open, and the pieces you embed in your own apps carry no copyleft obligations.`
          )
        }
      </p>
      <div class="grid-4 licenses">
        {
          licensing.map((l) => (
            <article class="card">
              <span class="tag">{l.tag}</span>
              <h3>{l.title}</h3>
              <p>{l.body}</p>
            </article>
          ))
        }
      </div>
      <div class="why-box">
        <h3>{i18n._(msg`Why this split?`)}</h3>
        <p>
          {
            i18n._(
              msg`A copyleft core keeps improvements to the server in the open. Permissive SDKs remove friction for every app that embeds them. And the CLA leaves a way to pay for development without ever closing the code, so the project can stay open and keep going.`
            )
          }
        </p>
        <a class="more" href={links.licensing}>{i18n._(msg`Read LICENSING.md`)}</a>
      </div>
    </div>
  </section>

  <section class="section" id="roadmap" aria-labelledby="road-title">
    <div class="wrap">
      <p class="kicker">{i18n._(msg`Status and roadmap`)}</p>
      <h2 id="road-title">{i18n._(msg`Where it stands today.`)}</h2>
      <p class="lead">
        {
          i18n._(
            msg`Yuva is pre-alpha and built in the open. Versions start at 0.0.1, there is no 1.0 until the project is ready, and the first release is being prepared now.`
          )
        }
      </p>
      <ol class="timeline">
        {
          roadmap.map((r) => (
            <li class={`t-${r.state}`}>
              <span class="t-mark" aria-hidden="true" />
              <div>
                <p class="t-state">{stateLabel[r.state]}</p>
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="fine">
        {
          i18n._(
            msg`Later: a Helm chart, optional push sent by Yuva itself, and retention periods per workspace. Not planned for now: a CRM, marketing e-mail, a public knowledge base or social-media channels.`
          )
        }
        <a href={links.roadmap}>{i18n._(msg`Full roadmap`)}</a>
      </p>
    </div>
  </section>

  <section class="section section-alt" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-layout">
      <div>
        <p class="kicker">{i18n._(msg`FAQ`)}</p>
        <h2 id="faq-title">{i18n._(msg`Questions people ask.`)}</h2>
        <p class="lead">{i18n._(msg`Something missing? Open an issue on GitHub.`)}</p>
      </div>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section closing" aria-labelledby="close-title">
    <div class="wrap closing-inner">
      <h2 id="close-title">{i18n._(msg`Give every product's users a way to reach you.`)}</h2>
      <p class="lead">{i18n._(msg`Read the code, run it on your machine, and follow along as it heads to its first release.`)}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={links.repo}>{i18n._(msg`View on GitHub`)}</a>
        <a class="btn btn-ghost" href={links.quickStart}>{i18n._(msg`Read the quick start`)}</a>
      </div>
    </div>
  </section>
</Base>
