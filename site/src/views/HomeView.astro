---
import { homeCopy } from "@/copy/home"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { absolute, home, links, VERSION, type Locale } from "@/lib/routes"
import Channels from "@/sections/Channels.astro"
import Close from "@/sections/Close.astro"
import Developers from "@/sections/Developers.astro"
import Faq from "@/sections/Faq.astro"
import Hero from "@/sections/Hero.astro"
import How from "@/sections/How.astro"
import Panel from "@/sections/Panel.astro"
import SelfHost from "@/sections/SelfHost.astro"
import Trust from "@/sections/Trust.astro"
import { shots } from "@/lib/shots"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = homeCopy(i18nFor(locale))

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Yuva",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Linux, Docker",
    description: c.meta.description,
    url: absolute(home[locale]),
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    codeRepository: links.repo,
    softwareVersion: VERSION,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
]
---

<Base locale={locale} title={c.meta.title} description={c.meta.description} jsonLd={jsonLd}>
  <Hero t={c.hero} shots={shots(locale)} locale={locale} />
  <Channels t={c.channels} shots={shots(locale)} />
  <How t={c.how} />
  <Panel t={c.panel} shots={shots(locale)} />
  <Developers t={c.developers} />
  <SelfHost t={c.host} />
  <Trust security={c.trust} open={c.open} />
  <Faq t={c.faq} />
  <Close t={c.close} hero={c.hero} />
</Base>
