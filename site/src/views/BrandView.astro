---
import { brandCopy } from "@/copy/brand"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { brand, brandAssets, links, type Locale } from "@/lib/routes"
import Logo from "@/ui/Logo.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = brandCopy(i18nFor(locale))
const small = "inline-flex h-8 items-center rounded-full border border-rule-strong px-3 text-xs font-medium transition-colors hover:bg-paper-deep"
const solid = "inline-flex h-11 items-center rounded-full bg-signal px-5 text-[0.95rem] font-medium text-white transition-colors hover:bg-signal/90"
const outline = "inline-flex h-11 items-center rounded-full border border-rule-strong px-5 text-[0.95rem] font-medium transition-colors hover:border-ink/40 hover:bg-paper-deep"
const h2 = "text-2xl font-semibold tracking-tight"
const sizes = [128, 64, 48, 32, 24, 16]
const dont = ["scale-x-[1.45] scale-y-75", "hue-rotate-[160deg]", "rotate-[18deg]", "drop-shadow-[0_6px_6px_rgb(0_0_0/0.45)] outline-3 outline-offset-2 outline-ink rounded-[22%]"]
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} paths={brand}>
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-24 sm:px-8 sm:pt-24">
    <section class="grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16" aria-labelledby="brand-title">
      <div>
        <p class="text-sm font-medium text-brand">{t.kicker}</p>
        <h1 id="brand-title" class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{t.title}</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">{t.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class={solid} href={brandAssets.icon} download="yuva-icon.svg">{t.downloadIcon}</a>
          <a class={outline} href={links.trademark}>{t.trademark}</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md pb-10" aria-hidden="true">
        <div class="mx-auto w-[16.5rem] rounded-[2.6rem] border-[7px] border-zinc-900 bg-[linear-gradient(160deg,#fde7dc,#f4f4f5_55%,#e4e4e7)] p-5 pt-10 shadow-[0_30px_60px_-30px_rgb(15_23_42/0.45)] dark:border-zinc-700 dark:bg-[linear-gradient(160deg,#2a140c,#18181b_55%,#09090b)]">
          <div class="grid grid-cols-4 gap-x-3 gap-y-4">
            {
              Array.from({ length: 16 }, (_, i) =>
                i === 5 ? (
                  <div class="grid justify-items-center gap-1">
                    <Logo class="size-12" />
                    <span class="text-[0.6rem] font-medium">Yuva</span>
                  </div>
                ) : (
                  <div class="grid justify-items-center gap-1">
                    <span class="size-12 rounded-[22%] bg-zinc-900/[0.07] dark:bg-white/[0.07]" />
                    <span class="h-1.5 w-7 rounded-full bg-zinc-900/[0.07] dark:bg-white/[0.07]" />
                  </div>
                )
              )
            }
          </div>
          <div class="mt-6 grid grid-cols-4 gap-3 rounded-[1.4rem] bg-white/50 p-2.5 dark:bg-white/[0.06]">
            {Array.from({ length: 4 }, () => <span class="aspect-square rounded-[22%] bg-zinc-900/[0.08] dark:bg-white/[0.08]" />)}
          </div>
        </div>
        <div class="absolute inset-x-0 bottom-0 overflow-hidden rounded-xl border border-rule bg-sheet shadow-[0_20px_40px_-20px_rgb(15_23_42/0.35)]">
          <div class="flex items-end gap-2 bg-paper-deep px-3 pt-2">
            <span class="flex max-w-[15rem] items-center gap-2 rounded-t-lg bg-sheet px-3 py-2 text-xs">
              <Logo size={14} />
              <span class="truncate">{t.tabTitle}</span>
            </span>
          </div>
          <div class="px-3 py-2.5">
            <span class="block h-6 rounded-md bg-paper-deep"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-28 border-t border-rule pt-14" aria-labelledby="sizes-title">
      <div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <h2 id="sizes-title" class={h2}>{t.sizesTitle}</h2>
          <p class="mt-3 text-ink-soft">{t.sizesBody}</p>
        </div>
        <ul class="flex flex-wrap items-end gap-x-10 gap-y-8">
          {
            sizes.map((s) => (
              <li class="grid justify-items-center gap-3">
                <Logo size={s} />
                <span class="font-mono text-xs text-ink-faint">{s}px</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="mt-20 border-t border-rule pt-14" aria-labelledby="logo-title">
      <h2 id="logo-title" class={h2}>{t.logoTitle}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          t.logos.map((l) => (
            <li class="overflow-hidden rounded-2xl border border-rule">
              <div class:list={["grid h-52 place-items-center p-10", l.dark ? "bg-[#0b0b0f]" : "bg-paper-deep"]}>
                <img class="max-h-24 w-auto" src={l.src} alt="" loading="lazy" />
              </div>
              <div class="flex flex-wrap items-end justify-between gap-4 border-t border-rule p-5">
                <div class="max-w-xs">
                  <h3 class="font-semibold tracking-tight">{l.title}</h3>
                  <p class="mt-1 text-sm text-ink-soft">{l.body}</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <button type="button" class={small} data-copy-url={l.src} data-done={t.copied}>
                    {t.copy}
                  </button>
                  <a class={small} href={l.src} download={l.file}>
                    {t.downloadSvg}
                  </a>
                  {l.png && (
                    <a class={small} href={l.png} download="yuva-icon-1024.png">
                      {t.downloadPng}
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-20 border-t border-rule pt-14" aria-labelledby="colors-title">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 id="colors-title" class={h2}>{t.colorsTitle}</h2>
        <p class="text-sm text-ink-faint">{t.colorsLead}</p>
      </div>
      <ul class="mt-8 grid overflow-hidden rounded-2xl border border-rule sm:grid-cols-5">
        {
          t.colors.map((c, i) => (
            <li class:list={["border-rule", i > 0 && "max-sm:border-t sm:border-s"]}>
              <button type="button" class="group block w-full text-start" data-copy-text={c.hex} data-done={t.copied}>
                <span class="block h-28 sm:h-40" style={`background:${c.hex}`} />
                <span class="flex items-baseline justify-between gap-2 px-4 py-3.5">
                  <span class="text-sm font-semibold">{c.name}</span>
                  <span class="font-mono text-xs text-ink-faint group-hover:text-ink" data-label>
                    {c.hex}
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-20 grid gap-10 border-t border-rule pt-14 lg:grid-cols-[18rem_minmax(0,1fr)]" aria-labelledby="type-title">
      <div>
        <h2 id="type-title" class={h2}>{t.typeTitle}</h2>
        <p class="mt-3 text-ink-soft">
          {t.typeBody}
          <a class="ms-1 font-medium text-brand hover:underline" href={links.geist}>Geist →</a>
        </p>
      </div>
      <div class="rounded-2xl border border-rule p-8">
        <p class="text-[clamp(2rem,1.2rem+2.6vw,3.2rem)] leading-[1.05] font-semibold tracking-[-0.035em]">{t.sample}</p>
        <div class="mt-8 flex flex-wrap items-end gap-x-10 gap-y-4 border-t border-rule pt-6">
          <span class="text-5xl font-normal tracking-tight">Aa</span>
          <span class="text-5xl font-medium tracking-tight">Aa</span>
          <span class="text-5xl font-semibold tracking-tight">Aa</span>
          <span class="ms-auto text-sm text-ink-faint">{t.weights}</span>
        </div>
      </div>
    </section>

    <section class="mt-20 border-t border-rule pt-14" aria-labelledby="rules-title">
      <h2 id="rules-title" class={h2}>{t.rulesTitle}</h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,4fr)]">
        <div>
          <p class="flex items-center gap-2 text-sm font-semibold"><span class="grid size-5 place-items-center rounded-full bg-emerald-500 text-[0.7rem] text-white">✓</span>{t.do}</p>
          <ul class="mt-3 grid grid-cols-2 gap-3">
            {
              t.doItems.map((label, i) => (
                <li>
                  <div class:list={["grid aspect-square place-items-center rounded-2xl border border-rule", i === 1 ? "bg-[#0b0b0f]" : "bg-paper-deep"]} aria-hidden="true">
                    <Logo class="size-16" />
                  </div>
                  <p class="mt-2 text-sm text-ink-soft">{label}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="flex items-center gap-2 text-sm font-semibold"><span class="grid size-5 place-items-center rounded-full bg-brand text-[0.7rem] text-white dark:bg-signal">✕</span>{t.dont}</p>
          <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {
              t.dontItems.map((label, i) => (
                <li>
                  <div class="grid aspect-square place-items-center rounded-2xl border border-rule bg-paper-deep" aria-hidden="true">
                    <Logo class:list={["size-16", dont[i]]} />
                  </div>
                  <p class="mt-2 text-sm text-ink-soft">{label}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-12 grid gap-8 rounded-2xl bg-paper-deep p-6 sm:p-8 md:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold">{t.may}</h3>
          <ul class="mt-3 grid gap-2 text-ink-soft">
            {t.mayItems.map((i) => <li class="ps-5 -indent-5">✓ {i}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold">{t.mayNot}</h3>
          <ul class="mt-3 grid gap-2 text-ink-soft">
            {t.mayNotItems.map((i) => <li class="ps-5 -indent-5">✕ {i}</li>)}
          </ul>
        </div>
        <p class="text-sm text-ink-soft md:col-span-2">
          {t.shape}
          <a class="ms-1 font-medium text-brand hover:underline" href={links.trademark}>{t.trademark} →</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  const flash = (el: HTMLElement) => {
    const target = el.querySelector<HTMLElement>("[data-label]") ?? el
    const before = target.textContent
    target.textContent = el.dataset.done ?? ""
    setTimeout(() => (target.textContent = before), 1400)
  }
  document.querySelectorAll<HTMLElement>("[data-copy-url]").forEach((el) => {
    el.addEventListener("click", async () => {
      const svg = await (await fetch(el.dataset.copyUrl!)).text()
      await navigator.clipboard.writeText(svg)
      flash(el)
    })
  })
  document.querySelectorAll<HTMLElement>("[data-copy-text]").forEach((el) => {
    el.addEventListener("click", async () => {
      await navigator.clipboard.writeText(el.dataset.copyText!)
      flash(el)
    })
  })
</script>
