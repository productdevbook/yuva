---
import { blogCopy } from "@/copy/pages"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { isoDay, minutes, posts } from "@/lib/blog"
import { bcp47, blog, post, type Locale } from "@/lib/routes"
import Logo from "@/ui/Logo.astro"
import PostCover from "@/ui/PostCover.astro"
import RssIcon from "@/ui/RssIcon.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = blogCopy(i18nFor(locale))
const [first, ...rest] = await posts()
const date = new Intl.DateTimeFormat(bcp47[locale], { dateStyle: "long", timeZone: "UTC" })
const rss = "inline-flex h-9 items-center gap-2 rounded-full border border-rule-strong px-4 text-sm font-medium transition-colors hover:border-ink/40 hover:bg-paper-deep"
---

<Base locale={locale} title={t.metaTitle} description={t.description} paths={blog}>
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-24 sm:px-8 sm:pt-24">
    <header class="flex flex-col gap-6 border-b border-rule pb-12 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-medium text-brand">{t.kicker}</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{t.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.lead}</p>
        {locale !== "en" && <p class="mt-3 text-sm text-ink-faint">{t.english}</p>}
      </div>
      <a class={rss} href="/blog/rss.xml">
        <RssIcon />
        {t.rss}
      </a>
    </header>

    {
      first && (
        <section class="mt-12" aria-labelledby="latest-title">
          <h2 id="latest-title" class="text-sm font-medium text-ink-faint">
            {t.latest}
          </h2>
          <a class="group mt-4 grid items-center gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-12" href={post(first.id)} hreflang="en">
            <PostCover title={first.data.title} class="transition-opacity group-hover:opacity-95" />
            <div lang="en">
              <p class="text-sm text-ink-faint">
                <time datetime={isoDay(first.data.date)}>{date.format(first.data.date)}</time>
                <span> · {t.readTime(minutes(first))}</span>
              </p>
              <h3 class="mt-3 text-3xl leading-tight font-semibold tracking-[-0.025em] group-hover:text-brand">{first.data.title}</h3>
              <p class="mt-4 text-lg leading-relaxed text-ink-soft">{first.data.description}</p>
              <p class="mt-6 flex items-center gap-3 text-sm">
                <Logo size={28} />
                <span class="font-medium">{first.data.author}</span>
              </p>
            </div>
          </a>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section class="mt-16 border-t border-rule pt-12" aria-labelledby="more-title">
          <h2 id="more-title" class="text-sm font-medium text-ink-faint">
            {t.more}
          </h2>
          <ul class="mt-6 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((p) => (
              <li>
                <a class="group block" href={post(p.id)} hreflang="en">
                  <PostCover title={p.data.title} size="sm" />
                  <p class="mt-5 text-sm text-ink-faint">
                    <time datetime={isoDay(p.data.date)}>{date.format(p.data.date)}</time>
                    <span> · {t.readTime(minutes(p))}</span>
                  </p>
                  <h3 class="mt-2 text-xl leading-snug font-semibold tracking-tight group-hover:text-brand" lang="en">
                    {p.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-ink-soft" lang="en">
                    {p.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <aside class="mt-20 flex flex-col gap-5 rounded-2xl border border-rule bg-paper-deep p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <p class="font-semibold tracking-tight">{t.follow}</p>
        <p class="mt-1 text-ink-soft">{t.followBody}</p>
      </div>
      <a class:list={[rss, "self-start bg-sheet sm:self-auto"]} href="/blog/rss.xml">
        <RssIcon />
        {t.rss}
      </a>
    </aside>
  </div>
</Base>
