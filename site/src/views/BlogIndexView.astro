---
import { blogCopy } from "@/copy/pages"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { isoDay, listFor, minutes } from "@/lib/blog"
import { bcp47, blog, post, type Locale } from "@/lib/routes"
import Logo from "@/ui/Logo.astro"
import PostCover from "@/ui/PostCover.astro"
import RssIcon from "@/ui/RssIcon.astro"
import Stop from "@/ui/Stop.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = blogCopy(i18nFor(locale))
const [first, ...rest] = await listFor(locale)
const date = new Intl.DateTimeFormat(bcp47[locale], { dateStyle: "long", timeZone: "UTC" })
const rss =
  "inline-flex h-9 items-center gap-2 rounded-full border border-rule-strong px-4 text-sm font-medium transition-colors hover:border-ink/40 hover:bg-paper-deep"
---

<Base locale={locale} title={t.metaTitle} description={t.description} paths={blog}>
  <header class="flex flex-col gap-6 px-5 pt-16 pb-12 sm:px-8 sm:pt-24 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-brand">{t.kicker}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">{t.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{t.lead}</p>
      {locale !== "en" && rest.concat(first ?? []).some((p) => p.lang === "en") && (
        <p class="mt-3 text-sm text-ink-faint">{t.english}</p>
      )}
    </div>
    <a class={rss} href="/blog/rss.xml">
      <RssIcon />
      {t.rss}
    </a>
  </header>

  {first && (
    <Stop labelledby="latest-title" index="01" label={t.latest} headed flush>
      <a
        class="group grid items-center lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]"
        href={post(first.slug, first.lang)}
        hreflang={first.lang}
      >
        <PostCover
          title={first.entry.data.title}
          class="border-b border-rule transition-opacity group-hover:opacity-95 lg:border-e lg:border-b-0"
        />
        <div class="px-5 py-10 sm:px-8" lang={first.lang}>
          <p class="text-sm text-ink-faint">
            <time datetime={isoDay(first.entry.data.date)}>{date.format(first.entry.data.date)}</time>
            <span> · {t.readTime(minutes(first.entry))}</span>
          </p>
          <h3 class="mt-3 text-3xl leading-tight font-semibold tracking-[-0.025em] group-hover:text-brand">
            {first.entry.data.title}
          </h3>
          <p class="mt-4 text-lg leading-relaxed text-ink-soft">{first.entry.data.description}</p>
          <p class="mt-6 flex items-center gap-3 text-sm">
            <Logo size={28} />
            <span class="font-medium">{first.entry.data.author}</span>
          </p>
        </div>
      </a>
    </Stop>
  )}

  {rest.length > 0 && (
    <Stop labelledby="more-title" index="02" label={t.more} headed flush>
      <ul class="-me-px -mb-px grid sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <li class="min-w-0 border-e border-b border-rule">
            <a class="group block p-5 sm:p-8" href={post(p.slug, p.lang)} hreflang={p.lang}>
              <PostCover title={p.entry.data.title} size="sm" />
              <p class="mt-5 text-sm text-ink-faint">
                <time datetime={isoDay(p.entry.data.date)}>{date.format(p.entry.data.date)}</time>
                <span> · {t.readTime(minutes(p.entry))}</span>
              </p>
              <h3 class="mt-2 text-xl leading-snug font-semibold tracking-tight group-hover:text-brand" lang={p.lang}>
                {p.entry.data.title}
              </h3>
              <p class="mt-2 line-clamp-2 text-ink-soft" lang={p.lang}>
                {p.entry.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </Stop>
  )}

  <Stop labelledby="follow-title" tone="deep">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 id="follow-title" class="font-semibold tracking-tight">
          {t.follow}
        </h2>
        <p class="mt-1 text-ink-soft">{t.followBody}</p>
      </div>
      <a class:list={[rss, "self-start bg-sheet sm:self-auto"]} href="/blog/rss.xml">
        <RssIcon />
        {t.rss}
      </a>
    </div>
  </Stop>
</Base>
