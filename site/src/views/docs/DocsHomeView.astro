---
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { docRel, href, nav } from "@/lib/docs"
import { docsPath, type Locale } from "@/lib/routes"
import DocsSearch from "@/ui/DocsSearch.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = docsCopy(i18nFor(locale))
const groups = await nav(locale)
---

<Base locale={locale} title={t.home.title} description={t.home.description} paths={docsPath("")}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <section class="max-w-2xl py-16 lg:py-24" aria-labelledby="docs-title">
      <p class="text-sm font-medium text-brand">{t.documentation}</p>
      <h1 id="docs-title" class="mt-3 text-[clamp(2.25rem,1.5rem+2.6vw,3.5rem)] leading-[1.06] font-semibold tracking-[-0.035em]">{t.home.heading}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">{t.home.lead}</p>
      {locale !== "en" && <p class="mt-3 text-sm text-ink-faint">{t.english}</p>}
      <div class="mt-8 max-w-md">
        <DocsSearch locale={locale} />
      </div>
    </section>

    <section class="border-t border-rule py-14" aria-labelledby="start-title">
      <h2 id="start-title" class="text-xl font-semibold tracking-tight">{t.home.startHere}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          t.home.starts.map((s, i) => (
            <li>
              <a class="group flex h-full flex-col rounded-3xl border border-rule p-6 transition-colors hover:border-rule-strong hover:bg-paper-deep" href={href(locale, docRel(s.slug))}>
                <span class="grid size-9 place-items-center rounded-full bg-brand-wash text-sm font-semibold text-brand">{i + 1}</span>
                <span class="mt-5 font-semibold tracking-tight group-hover:text-brand">{s.label}</span>
                <span class="mt-2 text-sm leading-relaxed text-ink-soft">{s.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="grid gap-10 border-t border-rule py-14 sm:grid-cols-2 lg:grid-cols-4" aria-label={t.documentation}>
      {
        groups.map((g) => (
          <div>
            <h2 class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{g.title}</h2>
            <ul class="mt-4 grid gap-2.5">
              {g.items.map((item) => (
                <li>
                  <a class="text-ink-soft transition-colors hover:text-brand" href={href(locale, item.rel)}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</Base>
