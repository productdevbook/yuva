---
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import DocsLayout from "@/layouts/DocsLayout.astro"
import { description, docs, href, nav, translatedCount } from "@/lib/docs"
import { docsPath, type Locale } from "@/lib/routes"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = docsCopy(i18nFor(locale))
const all = await docs(locale)
const englishOnly = locale !== "en" && (await translatedCount(locale)) === 0
const regions = (await nav(locale)).map((g) => ({
  ...g,
  items: g.items
    .filter((i) => i.slug !== "index")
    .map((i) => ({ ...i, text: i.slug === "api" ? t.api.description : description(all.get(i.slug)!) })),
}))
const headings = regions.map((g) => ({ depth: 2, slug: `docs-${g.key}`, text: g.title }))
---

<DocsLayout
  locale={locale}
  title={t.home.title}
  description={t.home.description}
  slug="index"
  rel=""
  headings={headings}
  english={false}
  home
>
  <section aria-labelledby="docs-title">
    <h1
      id="docs-title"
      class="text-[30px] leading-[38px] font-semibold tracking-[-0.02em] sm:text-4xl sm:leading-[44px]"
    >
      {t.home.heading}
    </h1>
    <p class="mt-2.5 text-lg leading-7 text-ink-soft">{t.home.lead}</p>
    {englishOnly && <p class="mt-3 text-sm text-ink-faint">{t.english}</p>}
  </section>

  {regions.map((g) => (
    <section class="mt-14" aria-labelledby={`docs-${g.key}`}>
      <h2 id={`docs-${g.key}`} class="mb-2 text-[22px] leading-7 font-semibold tracking-[-0.01em]">
        {g.title}
      </h2>
      <ul class="border-t border-rule-soft">
        {g.items.map((i) => (
          <li class="border-b border-rule-soft">
            <a class="group flex flex-wrap gap-x-6 gap-y-1 py-3.5" href={href(locale, i.rel)}>
              <span class="flex-[0_0_200px] text-[15px] font-semibold underline-offset-4 group-hover:underline">
                {i.title}
              </span>
              <span class="line-clamp-2 flex-[1_1_320px] text-[15px] leading-6 text-ink-soft">{i.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsLayout>
