---
import { Code } from "astro:components"
import { docsCopy } from "@/copy/docs"
import { homeCopy } from "@/copy/home"
import { i18nFor } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { description, docRel, docs, eventsRel, href, nav } from "@/lib/docs"
import { tags } from "@/lib/openapi"
import { docsPath, type Locale } from "@/lib/routes"
import DocsSearch from "@/ui/DocsSearch.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const i18n = i18nFor(locale)
const t = docsCopy(i18n)
const all = await docs()
const groups = await nav(locale)
const terminal = homeCopy(i18n).host.terminal
const endpoints = tags().reduce((n, tag) => n + tag.operations.length, 0)
const summary = (slug: string) => (slug === "api" ? t.home.apiSummary(endpoints) : description(all.get(slug)!))
const link = "font-medium text-brand hover:underline"
---

<Base locale={locale} title={t.home.title} description={t.home.description} paths={docsPath("")}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <section class="grid items-center gap-12 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16 lg:py-24" aria-labelledby="docs-title">
      <div>
        <p class="text-sm font-medium text-brand">{t.documentation}</p>
        <h1 id="docs-title" class="mt-3 text-[clamp(2.5rem,1.4rem+3.6vw,4.3rem)] leading-[1.04] font-semibold tracking-[-0.035em]">{t.home.heading}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">{t.home.lead}</p>
        {locale !== "en" && <p class="mt-3 text-sm text-ink-faint">{t.english}</p>}
        <div class="mt-8 max-w-sm">
          <DocsSearch locale={locale} />
        </div>
      </div>
      <div class="min-w-0 overflow-hidden rounded-2xl border border-night-rule bg-night shadow-paper">
        <div class="flex items-center gap-1.5 border-b border-night-rule px-4 py-3">
          <span class="size-2.5 rounded-full bg-white/15"></span>
          <span class="size-2.5 rounded-full bg-white/15"></span>
          <span class="size-2.5 rounded-full bg-white/15"></span>
          <a class="ms-auto text-xs text-glow hover:underline" href={`${href(locale, docRel("install"))}#quick-start-with-compose`}>{t.home.quickStart} →</a>
        </div>
        <Code code={terminal} lang="sh" themes={{ light: "github-dark", dark: "github-dark" }} />
      </div>
    </section>

    <section class="border-t border-rule py-16" aria-labelledby="start-title">
      <h2 id="start-title" class="text-2xl font-semibold tracking-tight">{t.home.startHere}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.home.starts.map((s, i) => (
            <li>
              <a class="group flex h-full flex-col rounded-3xl border border-rule p-6 transition-colors hover:border-rule-strong hover:bg-paper-deep" href={href(locale, docRel(s.slug))}>
                <span class="grid size-9 place-items-center rounded-full bg-brand-wash text-sm font-semibold text-brand">{i + 1}</span>
                <span class="mt-5 font-semibold tracking-tight group-hover:text-brand">{s.label}</span>
                <span class="mt-2 text-sm leading-relaxed text-ink-soft">{s.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-t border-rule py-16" aria-labelledby="all-title">
      <h2 id="all-title" class="text-2xl font-semibold tracking-tight">{t.home.allGuides}</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        {
          groups.map((g) => (
            <div>
              <h3 class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{g.title}</h3>
              <ul class="mt-3 divide-y divide-rule overflow-hidden rounded-2xl border border-rule">
                {g.items.map((item) => (
                  <li>
                    <a class="group block px-5 py-4 transition-colors hover:bg-paper-deep" href={href(locale, item.rel)}>
                      <span class="flex items-center justify-between gap-3 font-medium">
                        <span class="group-hover:text-brand">{item.title}</span>
                        <span class="text-ink-faint" aria-hidden="true">
                          →
                        </span>
                      </span>
                      <span class="mt-1 line-clamp-2 block text-sm leading-relaxed text-ink-soft" lang={item.slug === "api" ? undefined : "en"}>
                        {summary(item.slug)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-10 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-soft">
        {t.home.payloads}
        <a class={link} href={href(locale, eventsRel)}>{t.webhookEvents} →</a>
        <a class={link} href={href(locale, "api/")}>{t.apiReference} →</a>
      </p>
    </section>
  </div>
</Base>
