---
import { docsCopy } from "@/copy/docs"
import { i18nFor } from "@/i18n"
import DocsLayout from "@/layouts/DocsLayout.astro"
import { docRel, eventsRel, href, proseClass } from "@/lib/docs"
import { events } from "@/lib/openapi"
import type { Locale } from "@/lib/routes"
import FieldTable from "@/ui/FieldTable.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = docsCopy(i18nFor(locale))
const all = events()
const id = (name: string) => name.replace(/\./g, "-")
const headings = all.map((e) => ({ depth: 2, slug: id(e.name), text: e.name }))
---

<DocsLayout locale={locale} title={t.webhookEvents} description={t.api.eventsDescription} slug="api/events" rel={eventsRel} headings={headings}>
  <p class="text-sm font-medium text-brand">{t.apiReference}</p>
  <h1 class="mt-2 text-4xl font-semibold tracking-[-0.03em]">{t.webhookEvents}</h1>
  <p class="mt-4 text-lg leading-relaxed text-ink-soft">
    {t.api.eventsLead}
    <a class="ms-1 font-medium text-brand hover:underline" href={href(locale, docRel("webhooks"))}>{t.api.webhooksGuide} →</a>
  </p>

  {
    all.map((e) => (
      <section class="mt-14 scroll-mt-24 border-t border-rule pt-10" id={id(e.name)} aria-labelledby={`${id(e.name)}-title`}>
        <h2 id={`${id(e.name)}-title`} class="font-mono text-xl font-semibold">
          {e.name}
        </h2>
        {e.summary && (
          <p class="mt-2 text-ink-soft" lang="en">
            {e.summary}
          </p>
        )}
        {e.description && <div class:list={[proseClass, "mt-4"]} lang="en" set:html={e.description} />}
        {e.fields.length > 0 && (
          <>
            <h3 class="mt-6 flex items-baseline gap-2 text-sm font-semibold">
              {t.api.payload}
              {e.schema && <code class="font-mono text-xs font-normal text-ink-faint">{e.schema}</code>}
            </h3>
            <FieldTable rows={e.fields} columns={t.api.columns} />
          </>
        )}
      </section>
    ))
  }
</DocsLayout>
