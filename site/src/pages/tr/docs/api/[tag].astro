---
import { tags, type Tag } from "@/lib/openapi"
import ApiTagView from "@/views/docs/ApiTagView.astro"

export function getStaticPaths() {
  return tags().map((tag) => ({ params: { tag: tag.name }, props: { tag } }))
}

const { tag } = Astro.props as { tag: Tag }
---

<ApiTagView tag={tag} locale="tr" />
