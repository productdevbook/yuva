---
import { posts, slugOf } from "@/lib/blog"
import BlogPostView from "@/views/BlogPostView.astro"

export async function getStaticPaths() {
  return (await posts()).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }))
}
---

<BlogPostView entry={Astro.props.entry} locale="en" />
