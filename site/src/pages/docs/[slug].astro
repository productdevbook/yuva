---
import { ordered, slugOf, type Doc } from "@/lib/docs"
import DocPageView from "@/views/docs/DocPageView.astro"

export async function getStaticPaths() {
  return (await ordered("en")).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }))
}

const { entry } = Astro.props as { entry: Doc }
---

<DocPageView entry={entry} locale="en" />
