---
import DocsLayout from "@/layouts/DocsLayout.astro"
import { proseClass, tagHref } from "@/lib/docs"
import { tags, tagTitle, type Tag } from "@/lib/openapi"
import { links } from "@/lib/routes"
import FieldTable from "@/ui/FieldTable.astro"
import MethodBadge from "@/ui/MethodBadge.astro"

export function getStaticPaths() {
  return tags().map((tag) => ({ params: { tag: tag.name }, props: { tag } }))
}

const { tag } = Astro.props as { tag: Tag }
const name = tagTitle(tag.name)
const strip = (html: string) => html.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim()
const headings = tag.operations.map((op) => ({ depth: 2, slug: op.id, text: op.summary || `${op.method} ${op.path}` }))
const authLabel: Record<string, string> = { session: "Member session", apiKey: "API key", contactSession: "Contact session", none: "No authentication" }
---

<DocsLayout title={`${name} API`} description={strip(tag.description) || `${name} endpoints of the Yuva API.`} slug={`api/${tag.name}`} href={tagHref(tag.name)} headings={headings}>
  <p class="text-sm font-medium text-brand">API reference</p>
  <h1 class="mt-2 text-4xl font-semibold tracking-[-0.03em]">{name}</h1>
  {tag.description && <div class:list={[proseClass, "mt-4 text-lg"]} set:html={tag.description} />}

  <ul class="mt-8 divide-y divide-rule overflow-hidden rounded-2xl border border-rule">
    {
      tag.operations.map((op) => (
        <li>
          <a class="flex items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-paper-deep" href={`#${op.id}`}>
            <MethodBadge method={op.method} />
            <code class="min-w-0 truncate font-mono text-[0.82rem]">{op.path}</code>
            <span class="ms-auto hidden shrink-0 text-ink-faint sm:block">{op.summary}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    tag.operations.map((op) => (
      <section class="mt-16 scroll-mt-24 border-t border-rule pt-10" id={op.id} aria-labelledby={`${op.id}-title`}>
        <h2 id={`${op.id}-title`} class="text-2xl font-semibold tracking-tight">
          {op.summary || op.id}
        </h2>
        <p class="mt-4 flex min-w-0 items-center gap-3 rounded-xl bg-paper-deep px-4 py-3">
          <MethodBadge method={op.method} />
          <code class="min-w-0 font-mono text-sm break-all">{op.path}</code>
        </p>
        <p class="mt-3 flex flex-wrap gap-2 text-xs">
          {op.auth.map((a) => (
            <span class="rounded-full border border-rule px-2.5 py-1 text-ink-soft">{authLabel[a] ?? a}</span>
          ))}
          <span class="rounded-full border border-rule px-2.5 py-1 font-mono text-ink-faint">{op.id}</span>
        </p>
        {op.description && <div class:list={[proseClass, "mt-5"]} set:html={op.description} />}

        {op.params.length > 0 && (
          <>
            <h3 class="mt-8 text-sm font-semibold">Parameters</h3>
            <FieldTable rows={op.params} location />
          </>
        )}

        {op.body && (
          <>
            <h3 class="mt-8 flex flex-wrap items-baseline gap-2 text-sm font-semibold">
              Request body
              <code class="font-mono text-xs font-normal text-ink-faint">{op.body.contentType}</code>
              {op.body.schema && <code class="font-mono text-xs font-normal text-ink-soft">{op.body.schema}</code>}
            </h3>
            {op.body.fields.length > 0 && <FieldTable rows={op.body.fields} />}
          </>
        )}

        <h3 class="mt-8 text-sm font-semibold">Responses</h3>
        <ul class="mt-3 divide-y divide-rule overflow-hidden rounded-xl border border-rule text-sm">
          {op.responses.map((r) => (
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-2.5">
              <code
                class:list={[
                  "font-mono font-semibold",
                  r.status.startsWith("2") ? "text-emerald-700 dark:text-emerald-300" : r.status.startsWith("4") || r.status.startsWith("5") ? "text-red-700 dark:text-red-300" : "text-ink-soft",
                ]}
              >
                {r.status}
              </code>
              <span class="text-ink-soft [&_code]:font-mono [&_code]:text-[0.82rem] [&_code]:text-ink" set:html={r.description} />
              {r.schema && <code class="ms-auto font-mono text-xs text-ink-faint">{r.schema}</code>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="mt-16 text-sm text-ink-soft">
    Schemas and every field are in the <a class="font-medium text-brand hover:underline" href={links.openapi}>OpenAPI contract</a>.
  </p>
</DocsLayout>
