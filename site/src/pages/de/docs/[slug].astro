---
import { ordered, type Doc } from "@/lib/docs"
import DocPageView from "@/views/docs/DocPageView.astro"

export async function getStaticPaths() {
  return (await ordered()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props as { entry: Doc }
---

<DocPageView entry={entry} locale="de" />
