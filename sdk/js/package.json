{
  "name": "useyuva",
  "version": "0.0.16",
  "description": "Yuva for the web: a headless client for contacts, the <yuva-chat> element, documentation page feedback and discussions, the <yuva-subscribe> mailing list form, cookieless web analytics, React hooks, a Nuxt module, a typed /v1 client and server helpers for identity tokens, webhooks and server-side analytics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productdevbook/yuva.git",
    "directory": "sdk/js"
  },
  "bugs": "https://github.com/productdevbook/yuva/issues",
  "keywords": [
    "yuva",
    "chat",
    "support",
    "live-chat",
    "web-component",
    "customer-messaging",
    "nuxt",
    "nitro",
    "newsletter",
    "analytics"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/esm/chat.js",
    "./dist/esm/docs.js",
    "./dist/esm/subscribe.js",
    "./dist/yuva.js",
    "./dist/yuva-chat.js",
    "./dist/yuva-docs.js",
    "./dist/yuva-analytics.js",
    "./dist/yuva-analytics-consent.js",
    "./dist/yuva-subscribe.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./chat": {
      "types": "./dist/types/chat.d.ts",
      "default": "./dist/esm/chat.js"
    },
    "./docs": {
      "types": "./dist/types/docs.d.ts",
      "default": "./dist/esm/docs.js"
    },
    "./subscribe": {
      "types": "./dist/types/subscribe.d.ts",
      "default": "./dist/esm/subscribe.js"
    },
    "./analytics": {
      "types": "./dist/types/analytics.d.ts",
      "default": "./dist/esm/analytics.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "default": "./dist/esm/react.js"
    },
    "./api": {
      "types": "./dist/types/api.d.ts",
      "default": "./dist/esm/api.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "default": "./dist/esm/server.js"
    },
    "./h3": {
      "types": "./dist/types/h3.d.ts",
      "default": "./dist/esm/h3.js"
    },
    "./nuxt": {
      "types": "./dist/types/nuxt/module.d.ts",
      "default": "./dist/esm/nuxt/module.js"
    },
    "./nuxt/components": {
      "types": "./dist/types/nuxt/runtime/components.d.ts",
      "default": "./dist/esm/nuxt/runtime/components.js"
    },
    "./nuxt/analytics": {
      "types": "./dist/types/nuxt/runtime/analytics.d.ts",
      "default": "./dist/esm/nuxt/runtime/analytics.js"
    },
    "./nuxt/plugin": {
      "types": "./dist/types/nuxt/runtime/plugin.d.ts",
      "default": "./dist/esm/nuxt/runtime/plugin.js"
    },
    "./nitro": {
      "types": "./dist/types/nitro/module.d.ts",
      "default": "./dist/esm/nitro/module.js"
    },
    "./nitro/runtime": {
      "types": "./dist/types/nitro/runtime/define.d.ts",
      "default": "./dist/esm/nitro/runtime/define.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bunx openapi-typescript@7.13.0 ../../openapi/openapi.yaml -o src/schema.gen.ts",
    "extract": "lingui extract --clean --workers 1",
    "compile": "lingui compile --strict --typescript",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run compile && bun run typecheck && bun test",
    "build": "bun run compile && bun scripts/build.ts",
    "example": "bun scripts/serve.ts",
    "prepublishOnly": "bun run check && bun run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@lingui/core": "^6.9.0",
    "openapi-fetch": "0.17.0"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.15.0",
    "h3": "^2.0.0",
    "react": ">=18",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@lingui/cli": "^6.9.0",
    "@lingui/conf": "^6.9.0",
    "@lingui/format-po": "^6.9.0",
    "@lingui/native-tools": "^0.1.5",
    "@nuxt/kit": "4.6.1",
    "@nuxt/schema": "4.6.1",
    "@types/bun": "^1.4.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "h3": "2.0.2",
    "h3-v1": "npm:h3@1.15.11",
    "happy-dom": "^20.14.5",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^7.0.2",
    "vue": "3.5.43"
  }
}
