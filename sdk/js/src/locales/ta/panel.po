#: src/panel/home.ts
msgid "Talk to us"
msgstr "எங்களிடம் பேசுங்கள்"

#: src/panel/chat.ts
msgid "Thanks for your feedback"
msgstr "உங்கள் கருத்துக்கு நன்றி"

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "நன்றி! நாங்கள் பதிலளிக்கும்போது நீங்கள் இல்லையெனில் {known} முகவரிக்கு மின்னஞ்சல் அனுப்புவோம்."

#: src/panel/chat.ts
msgid "That address doesn't accept mail. Check it for a typo."
msgstr "இந்த முகவரி அஞ்சலை ஏற்கவில்லை. எழுத்துப் பிழை உள்ளதா எனப் பாருங்கள்."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "கோப்பு மிகப் பெரியது."

#: src/panel/chat.ts
msgid "This conversation is no longer available."
msgstr "இந்த உரையாடல் இனி கிடைக்காது."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "இந்தக் கோப்பு வகை ஏற்கப்படாது."

#: src/panel/chat.ts
msgid "to send"
msgstr "அனுப்ப"

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "மிக அதிக முயற்சிகள். சிறிது காத்திருந்து மீண்டும் முயலுங்கள்."

#: src/panel/chat.ts
msgid "Try again"
msgstr "மீண்டும் முயல்க"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "தட்டச்சு செய்கிறார்…"

#: src/panel/chat.ts
msgid "Uploading…"
msgstr "பதிவேற்றப்படுகிறது…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "பொதுவாக {duration} இல் பதிலளிப்பார்"

#: src/panel/home.ts
msgid "Vote on what comes next"
msgstr "அடுத்து என்ன வரவேண்டும் என்று வாக்களியுங்கள்"

#: src/panel/chat.ts
msgid "We couldn't reach {address}"
msgstr "{address} முகவரியை அடைய முடியவில்லை"

#: src/panel/chat.ts
msgid "We sent a link to {address}. Open it so replies reach you by e-mail."
msgstr "{address} முகவரிக்கு ஒரு இணைப்பை அனுப்பினோம். பதில்கள் மின்னஞ்சலிலும் வர அதைத் திறக்கவும்."

#: src/panel/chat.ts
msgid "We sent it again."
msgstr "மீண்டும் அனுப்பினோம்."

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "எங்களால் முடிந்தவரை விரைவாகப் பதிலளிப்போம்"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "நாங்கள் தற்போது இல்லை"

#: src/panel/home.ts
msgid "What's new"
msgstr "புதியவை"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "செய்தியை எழுதுங்கள்…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "நீங்கள் ஆஃப்லைனில் இருப்பதாகத் தெரிகிறது."

#: src/panel/chat.ts
#: src/panel/home.ts
msgid "You:"
msgstr "நீங்கள்:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "you@example.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "உங்கள் உள்நுழைவு காலாவதியானது. பக்கத்தை மீண்டும் ஏற்றி மீண்டும் முயலுங்கள்."
