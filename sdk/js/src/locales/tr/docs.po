#: src/docs/questions.ts
msgid "Ask a question"
msgstr "Soru sorun"

#: src/docs/questions.ts
msgid "Ask another question"
msgstr "Başka bir soru sorun"

#: src/docs/base.ts
msgid "Could not send. Try again."
msgstr "Gönderilemedi. Yeniden deneyin."

#: src/docs/feedback.ts
#: src/docs/questions.ts
msgid "E-mail address"
msgstr "E-posta adresi"

#: src/docs/feedback.ts
msgid "E-mail for a reply (optional)"
msgstr "Yanıt için e-posta (isteğe bağlı)"

#: src/docs/questions.ts
msgid "E-mail for the answer (optional)"
msgstr "Cevap için e-posta (isteğe bağlı)"

#: src/docs/feedback.ts
#: src/docs/questions.ts
msgid "Enter a valid e-mail address."
msgstr "Geçerli bir e-posta adresi girin."

#: src/docs/feedback.ts
msgid "No"
msgstr "Hayır"

#: src/docs/feedback.ts
msgid "No thanks"
msgstr "Hayır, teşekkürler"

#: src/docs/questions.ts
msgid "Questions and answers"
msgstr "Sorular ve cevaplar"

#: src/docs/feedback.ts
msgid "Send"
msgstr "Gönder"

#: src/docs/questions.ts
msgid "Send question"
msgstr "Soruyu gönder"

#: src/docs/feedback.ts
#: src/docs/questions.ts
msgid "Sending…"
msgstr "Gönderiliyor…"

#: src/docs/questions.ts
msgid "Sign in to ask a question."
msgstr "Soru sormak için oturum açın."

#: src/docs/base.ts
msgid "Sign in to write to us."
msgstr "Bize yazmak için oturum açın."

#: src/docs/feedback.ts
msgid "Sorry about that. What was missing or unclear?"
msgstr "Üzgünüz. Eksik ya da anlaşılmayan ne vardı?"

#: src/docs/feedback.ts
msgid "Thanks for your feedback."
msgstr "Geri bildiriminiz için teşekkürler."

#: src/docs/feedback.ts
msgid "Thanks! Anything we could add? (optional)"
msgstr "Teşekkürler! Ekleyebileceğimiz bir şey var mı? (isteğe bağlı)"

#: src/docs/questions.ts
msgid "Thanks! We'll e-mail the answer to {email}."
msgstr "Teşekkürler! Cevabı {email} adresine e-postayla göndereceğiz."

#: src/docs/questions.ts
msgid "Thanks! Your question was sent."
msgstr "Teşekkürler! Sorunuz gönderildi."

#: src/docs/base.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Çok fazla deneme. Biraz bekleyip tekrar deneyin."

#: src/docs/feedback.ts
msgid "Was this page helpful?"
msgstr "Bu sayfa işinize yaradı mı?"

#: src/docs/questions.ts
msgid "What would you like to know about this page?"
msgstr "Bu sayfayla ilgili ne öğrenmek istersiniz?"

#: src/docs/feedback.ts
msgid "Yes"
msgstr "Evet"

#: src/docs/base.ts
msgid "You seem to be offline."
msgstr "Çevrimdışı görünüyorsunuz."
