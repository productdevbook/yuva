#: src/panel/chat.ts
msgid "{name} is typing…"
msgstr "{name} yazıyor…"

#: src/panel/chat.ts
msgid "All conversations"
msgstr "Tüm konuşmalar"

#: src/panel/chat.ts
msgid "Attach files"
msgstr "Dosya ekle"

#: src/panel/chat.ts
msgid "Attachment"
msgstr "Ek"

#: src/panel/chat.ts
msgid "Chat is not available right now."
msgstr "Sohbet şu anda kullanılamıyor."

#: src/panel/chat.ts
msgid "Close"
msgstr "Kapat"

#: src/panel/chat.ts
msgid "Conversation"
msgstr "Konuşma"

#: src/panel/chat.ts
msgid "Could not save your e-mail address. Try again."
msgstr "E-posta adresiniz kaydedilemedi. Tekrar deneyin."

#: src/panel/chat.ts
msgid "E-mail address"
msgstr "E-posta adresi"

#: src/panel/chat.ts
msgid "Enter a valid e-mail address."
msgstr "Geçerli bir e-posta adresi girin."

#: src/panel/chat.ts
msgid "Loading…"
msgstr "Yükleniyor…"

#: src/panel/chat.ts
msgid "Message"
msgstr "Mesaj"

#: src/panel/chat.ts
msgid "Messages"
msgstr "Mesajlar"

#: src/panel/chat.ts
msgid "New conversation"
msgstr "Yeni konuşma"

#: src/panel/chat.ts
msgid "No conversations yet"
msgstr "Henüz konuşma yok"

#: src/panel/chat.ts
msgid "Nobody is available right now. Leave your e-mail and we'll send the reply there too."
msgstr "Şu anda müsait kimse yok. E-posta adresinizi bırakın, yanıtı oraya da gönderelim."

#: src/panel/chat.ts
msgid "Not sent."
msgstr "Gönderilemedi."

#: src/panel/chat.ts
msgid "Online"
msgstr "Çevrimiçi"

#: src/panel/chat.ts
msgid "Reconnecting…"
msgstr "Yeniden bağlanıyor…"

#. placeholder {0}: file.name
#: src/panel/chat.ts
msgid "Remove {0}"
msgstr "{0} kaldır"

#: src/panel/chat.ts
msgid "Retry"
msgstr "Tekrar dene"

#: src/panel/chat.ts
msgid "Save"
msgstr "Kaydet"

#: src/panel/chat.ts
msgid "Seen"
msgstr "Görüldü"

#: src/panel/chat.ts
msgid "Send"
msgstr "Gönder"

#: src/panel/chat.ts
msgid "Send us a message and we will reply here."
msgstr "Bize bir mesaj gönderin, yanıtımız burada görünecek."

#: src/panel/chat.ts
msgid "Sending…"
msgstr "Gönderiliyor…"

#: src/panel/chat.ts
msgid "Sent"
msgstr "Gönderildi"

#: src/panel/chat.ts
msgid "Show older conversations"
msgstr "Eski konuşmaları göster"

#: src/panel/chat.ts
msgid "Sign in to chat with us."
msgstr "Bizimle sohbet etmek için giriş yapın."

#: src/panel/chat.ts
msgid "Thanks! We'll e-mail you at {known} if you're gone when we reply."
msgstr "Teşekkürler! Yanıtladığımızda burada değilseniz {known} adresine e-posta göndereceğiz."

#: src/panel/chat.ts
msgid "The file is too large."
msgstr "Dosya çok büyük."

#: src/panel/chat.ts
msgid "This file type is not accepted."
msgstr "Bu dosya türü kabul edilmiyor."

#: src/panel/chat.ts
msgid "Too many attempts. Wait a moment and try again."
msgstr "Çok fazla deneme. Biraz bekleyip tekrar deneyin."

#: src/panel/chat.ts
msgid "Try again"
msgstr "Tekrar dene"

#: src/panel/chat.ts
msgid "Typing…"
msgstr "Yazıyor…"

#: src/panel/chat.ts
msgid "Usually replies in {duration}"
msgstr "Genellikle {duration} içinde yanıt verir"

#: src/panel/chat.ts
msgid "We'll reply as soon as we can"
msgstr "En kısa sürede yanıt vereceğiz"

#: src/panel/chat.ts
msgid "We're away right now"
msgstr "Şu anda uzaktayız"

#: src/panel/chat.ts
msgid "Write a message…"
msgstr "Bir mesaj yazın…"

#: src/panel/chat.ts
msgid "You seem to be offline."
msgstr "Çevrimdışı görünüyorsunuz."

#: src/panel/chat.ts
msgid "You:"
msgstr "Siz:"

#: src/panel/chat.ts
msgid "you@example.com"
msgstr "siz@ornek.com"

#: src/panel/chat.ts
msgid "Your sign-in has expired. Reload the page and try again."
msgstr "Oturumunuzun süresi doldu. Sayfayı yenileyip tekrar deneyin."
