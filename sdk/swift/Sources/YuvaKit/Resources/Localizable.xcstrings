    "error.attachmentMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot could not be read as an image. Choose another one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ekran görüntüsü görsel olarak okunamadı. Başka birini seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة لقطة شاشة كصورة. اختر لقطة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি স্ক্রিনশট ছবি হিসেবে পড়া যায়নি। অন্যটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut llegir una captura de pantalla com a imatge. Tria’n una altra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímek obrazovky se nepodařilo přečíst jako obrázek. Vyberte jiný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et skærmbillede kunne ikke læses som et billede. Vælg et andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Screenshot konnte nicht als Bild gelesen werden. Wählen Sie einen anderen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα στιγμιότυπο οθόνης δεν διαβάστηκε ως εικόνα. Επιλέξτε άλλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer una captura de pantalla como imagen. Elige otra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer una captura de pantalla como imagen. Elige otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvakaappausta ei voitu lukea kuvana. Valitse toinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture d’écran n’a pas pu être lue comme une image. Choisissez-en une autre."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture d’écran n’a pas pu être lue comme une image. Choisissez-en une autre."
          }
        },
        "gu": {
          "stringUnit": {
