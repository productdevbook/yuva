    "feedback.metadataHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App version, device, system version and language are sent with your feedback."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama sürümü, cihaz, sistem sürümü ve dil geri bildiriminizle birlikte gönderilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسَل إصدار التطبيق والجهاز وإصدار النظام واللغة مع ملاحظاتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের সংস্করণ, ডিভাইস, সিস্টেমের সংস্করণ ও ভাষা আপনার মতামতের সাথে পাঠানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La versió de l’app, el dispositiu, la versió del sistema i l’idioma s’envien amb els teus comentaris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spolu se zpětnou vazbou se odesílá verze aplikace, zařízení, verze systému a jazyk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appversion, enhed, systemversion og sprog sendes med din feedback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Version, Gerät, Systemversion und Sprache werden mit Ihrem Feedback gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκδοση της εφαρμογής, η συσκευή, η έκδοση του συστήματος και η γλώσσα αποστέλλονται μαζί με τα σχόλιά σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de la app, el dispositivo, la versión del sistema y el idioma se envían con tus comentarios."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de la app, el dispositivo, la versión del sistema y el idioma se envían con tus comentarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen versio, laite, järjestelmän versio ja kieli lähetetään palautteesi mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de l’app, l’appareil, la version du système et la langue sont envoyés avec votre commentaire."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de l’appli, l’appareil, la version du système et la langue sont envoyés avec votre rétroaction."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એપ્લિકેશનનું વર્ઝન, ઉપકરણ, સિસ્ટમનું વર્ઝન અને ભાષા તમારા પ્રતિસાદ સાથે મોકલવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסת האפליקציה, המכשיר, גרסת המערכת והשפה נשלחים יחד עם המשוב שלכם."
