    "conversations.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send us a message and we will get back to you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize bir mesaj gönderin, size dönüş yapalım."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل لنا رسالة وسنرد عليك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের একটি বার্তা পাঠান, আমরা উত্তর দেব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia’ns un missatge i et respondrem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište nám a my se vám ozveme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send os en besked, så vender vi tilbage til dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie uns, wir melden uns bei Ihnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε μας ένα μήνυμα και θα σας απαντήσουμε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíanos un mensaje y te responderemos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíanos un mensaje y te responderemos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä meille viesti, niin vastaamme sinulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-nous un message, nous vous répondrons."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-nous un message, nous vous répondrons."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમને સંદેશ મોકલો, અમે તમને જવાબ આપીશું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלחו לנו הודעה ונחזור אליכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें संदेश भेजें, हम आपको जवाब देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošaljite nam poruku, javit ćemo vam se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írjon nekünk, és válaszolunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirimi kami pesan, kami akan membalasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivici un messaggio e ti risponderemo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージをお送りください。折り返しご連絡します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮಗೆ ಸಂದೇಶ ಕಳುಹಿಸಿ, ನಾವು ಉತ್ತರಿಸುತ್ತೇವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 보내 주시면 답변드리겠습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങൾക്ക് ഒരു സന്ദേശം അയയ്ക്കൂ, ഞങ്ങൾ മറുപടി നൽകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्हाला संदेश पाठवा, आम्ही उत्तर देऊ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantar mesej kepada kami dan kami akan membalas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send oss en melding, så svarer vi deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur ons een bericht, dan nemen we contact met je op."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆମକୁ ଏକ ବାର୍ତ୍ତା ପଠାନ୍ତୁ, ଆମେ ଉତ୍ତର ଦେବୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਨੂੰ ਸੁਨੇਹਾ ਭੇਜੋ, ਅਸੀਂ ਤੁਹਾਨੂੰ ਜਵਾਬ ਦੇਵਾਂਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz do nas, a odpowiemy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie uma mensagem e responderemos você."
          }
        },
        "pt-PT": {
          "stringUnit": {
