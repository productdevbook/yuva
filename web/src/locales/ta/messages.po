#: src/components/common/text.ts
msgid "This does not fit the inbox's purpose."
msgstr "இது இன்பாக்ஸின் நோக்கத்துக்குப் பொருந்தாது."

#: src/components/common/text.ts
msgid "This domain is already in the list."
msgstr "This domain is already in the list."

#: src/components/common/text.ts
msgid "This e-mail address bounced or complained, so the reply was not sent. Clear it on the contact to send again."
msgstr "இந்த மின்னஞ்சல் முகவரி திரும்பியது அல்லது புகாரளித்தது; எனவே பதில் அனுப்பப்படவில்லை. மீண்டும் அனுப்ப தொடர்பில் அதை அழியுங்கள்."

#: src/features/settings/webhooks/WebhookWizard.tsx
msgid "This endpoint receives only the events of {lockedName}."
msgstr "இந்த முனை {lockedName}-இன் நிகழ்வுகளை மட்டுமே பெறும்."

#: src/components/common/text.ts
msgid "This file type is not allowed."
msgstr "இந்தக் கோப்பு வகை அனுமதிக்கப்படவில்லை."

#: src/components/common/text.ts
msgid "This goal is a step of a funnel. Take it out of the funnel, or delete the funnel, first."
msgstr "இந்த இலக்கு ஒரு புனலின் படி. முதலில் அதைப் புனலிலிருந்து எடுங்கள், அல்லது புனலை நீக்குங்கள்."

#: src/components/common/text.ts
#: src/features/broadcasts/ListForm.tsx
msgid "This inbox already has a list with this name."
msgstr "இந்த இன்பாக்ஸில் இந்தப் பெயரில் பட்டியல் ஏற்கெனவே உள்ளது."

#: src/components/common/text.ts
msgid "This inbox already has a status page."
msgstr "இந்த இன்பாக்ஸுக்கு ஏற்கெனவே நிலைப் பக்கம் உள்ளது."

#: src/features/docs/InstallDialog.tsx
