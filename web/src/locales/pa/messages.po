#: src/features/migrations/MapStep.tsx
msgid "The scan is running. You can change these when it is done."
msgstr "ਸਕੈਨ ਚੱਲ ਰਿਹਾ ਹੈ। ਖ਼ਤਮ ਹੋਣ ਉੱਤੇ ਤੁਸੀਂ ਇਹਨਾਂ ਨੂੰ ਬਦਲ ਸਕਦੇ ਹੋ।"

#: src/features/setup/AddChannelStep.tsx
#: src/features/setup/InstallStep.tsx
