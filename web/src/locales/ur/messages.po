#: src/features/migrations/MigrationsPage.tsx
msgid "Yuva only reads the source; nothing there is changed."
msgstr "Yuva صرف ماخذ پڑھتا ہے؛ وہاں کچھ تبدیل نہیں ہوتا۔"

#: src/features/migrations/SignInConnectStep.tsx
msgid "Yuva only reads. Besides signing in, its connection sends {provider} nothing but read requests, so no ticket, customer or setting changes."
msgstr "Yuva صرف پڑھتا ہے۔ سائن ان کے علاوہ اس کا کنکشن {provider} کو صرف پڑھنے کی درخواستیں بھیجتا ہے، اس لیے کوئی ٹکٹ، صارف یا ترتیب نہیں بدلتی۔"

#: src/features/migrations/ConnectStep.tsx
msgid "Yuva only reads. It never deletes, moves, archives or marks anything as read in {provider}, and your mail stays where it is."
msgstr "Yuva صرف پڑھتا ہے۔ یہ {provider} میں کبھی کچھ حذف، منتقل، آرکائیو یا پڑھا ہوا نشان زد نہیں کرتا، اور آپ کی میل جہاں ہے وہیں رہتی ہے۔"

#: src/features/migrations/TokenConnectStep.tsx
msgid "Yuva only reads. Its connection sends {provider} nothing but read requests, and the token only to {provider}'s API, so no ticket, customer or setting changes."
msgstr "Yuva صرف پڑھتا ہے۔ اس کا کنکشن {provider} کو پڑھنے کی درخواستوں کے سوا کچھ نہیں بھیجتا، اور ٹوکن صرف {provider} کے API کو، اس لیے کوئی ٹکٹ، گاہک یا ترتیب نہیں بدلتی۔"

#: src/features/status/MonitorDialog.tsx
msgid "Yuva opens a connection to a host and port on a schedule."
msgstr "Yuva وقتاً فوقتاً کسی ہوسٹ اور پورٹ سے کنکشن کھولتا ہے۔"

#: src/features/migrations/TokenConnectStep.tsx
msgid "Yuva reads {provider} with an API token you create in your own account, and only reads."
msgstr "Yuva آپ کے اپنے اکاؤنٹ میں بنائے گئے API ٹوکن سے {provider} پڑھتا ہے، اور صرف پڑھتا ہے۔"

#: src/features/migrations/Wizard.tsx
msgid "Yuva reads only the file you upload and deletes it when the migration ends. History arrives quietly: no notifications, no auto-replies."
msgstr "Yuva صرف وہ فائل پڑھتا ہے جو آپ اپ لوڈ کریں اور منتقلی ختم ہونے پر اسے حذف کر دیتا ہے۔ تاریخ خاموشی سے آتی ہے: کوئی اطلاع نہیں، کوئی خودکار جواب نہیں۔"

#: src/features/status/MonitorDialog.tsx
msgid "Yuva requests an address on a schedule and checks the answer."
msgstr "Yuva وقتاً فوقتاً کسی پتے کو درخواست بھیجتا ہے اور جواب جانچتا ہے۔"

#: src/features/settings/webhooks/WebhookWizard.tsx
msgid "Yuva sends a signed POST request with a JSON body for every event you pick."
msgstr "Yuva ہر اس واقعے کے لیے JSON باڈی کے ساتھ دستخط شدہ POST درخواست بھیجتا ہے جو آپ چنیں۔"

#: src/features/migrations/SignInConnectStep.tsx
msgid "Yuva signs in to {provider} with an OAuth client you create in your own account, and only reads."
msgstr "Yuva {provider} میں اس OAuth کلائنٹ سے سائن ان کرتا ہے جو آپ اپنے اکاؤنٹ میں بناتے ہیں، اور صرف پڑھتا ہے۔"

#: src/features/settings/channels/email/Deliverability.tsx
msgid "Yuva signs this channel’s broadcasts, tests, confirmation and welcome mails with its own key, over the unsubscribe headers. Your provider’s signature stays next to it; support replies are not changed."
msgstr "Yuva اس چینل کے براڈکاسٹس، ٹیسٹس، تصدیقی اور خوش آمدیدی میلز پر اپنی کلید سے دستخط کرتا ہے، ان سبسکرائب ہیڈرز کے اوپر۔ آپ کے فراہم کنندہ کا دستخط اس کے ساتھ رہتا ہے؛ سپورٹ جوابات نہیں بدلتے۔"

#: src/features/settings/channels/email/Deliverability.tsx
msgid "Yuva stops signing with it at once. Remove the DNS record afterwards; a new key needs a new record."
msgstr "Yuva اس سے فوراً دستخط کرنا بند کر دیتا ہے۔ اس کے بعد DNS ریکارڈ ہٹا دیں؛ نئی کلید کو نیا ریکارڈ چاہیے۔"

#: src/features/migrations/text.ts
msgid "Yuva stored nothing. Give the app registration only the permissions IMAP.AccessAsUser.All and offline_access, then sign in again."
msgstr "Yuva نے کچھ محفوظ نہیں کیا۔ ایپ رجسٹریشن کو صرف IMAP.AccessAsUser.All اور offline_access اجازتیں دیں، پھر دوبارہ سائن ان کریں۔"

#: src/features/migrations/text.ts
msgid "Yuva stored nothing. Make sure the OAuth client asks for nothing more than read, then sign in again."
msgstr "Yuva نے کچھ محفوظ نہیں کیا۔ یقینی بنائیں کہ OAuth کلائنٹ read سے زیادہ کچھ نہیں مانگتا، پھر دوبارہ سائن ان کریں۔"

#: src/features/migrations/text.ts
msgid "Yuva stored nothing. Sign in again; if this keeps happening, tell the operator of this Yuva server."
msgstr "Yuva نے کچھ محفوظ نہیں کیا۔ دوبارہ سائن ان کریں؛ اگر یہ ہوتا رہے تو اس Yuva سرور کے آپریٹر کو بتائیں۔"

#: src/features/settings/webhooks/sections.tsx
msgid "Yuva turned this endpoint off on {disabledAt}."
msgstr "Yuva نے یہ اینڈ پوائنٹ {disabledAt} کو بند کیا۔"

#: src/features/settings/webhooks/sections.tsx
msgid "Yuva turned this endpoint off."
msgstr "Yuva نے یہ اینڈ پوائنٹ بند کر دیا۔"

#: src/components/common/text.ts
msgid "Yuva's own notes cannot be changed."
msgstr "Yuva کے اپنے نوٹس بدلے نہیں جا سکتے۔"

#: src/features/migrations/MigrationsPage.tsx
msgid "Zendesk, Help Scout, Front, Freshdesk, Intercom, Crisp"
msgstr "Zendesk, Help Scout, Front, Freshdesk, Intercom, Crisp"
