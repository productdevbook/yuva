#: src/components/common/text.ts
msgid "Your session has ended. Sign in again."
msgstr "세션이 종료되었습니다. 다시 로그인하세요."

#: src/features/migrations/Wizard.tsx
msgid "Your support address"
msgstr "내 지원 주소"

#: src/features/migrations/MapStep.tsx
msgid "Your team"
msgstr "내 팀"

#: src/features/broadcasts/ReviewPanel.tsx
