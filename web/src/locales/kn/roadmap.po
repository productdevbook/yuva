#: src/features/roadmap/IdeaFeedback.tsx
msgid "Resolved feedback does not get it: {closed}"
msgstr "ಪರಿಹರಿಸಿದ ಪ್ರತಿಕ್ರಿಯೆಗಳಿಗೆ ಇದು ಸಿಗುವುದಿಲ್ಲ: {closed}"

#: src/features/roadmap/Board.tsx
