#: src/components/common/SearchError.tsx
msgid "This search cannot be used: {0}"
msgstr "ಈ ಹುಡುಕಾಟವನ್ನು ಬಳಸಲಾಗದು: {0}"

#: src/components/common/text.ts
msgid "This server does not offer imports from this kind of mailbox."
msgstr "ಈ ಸರ್ವರ್ ಈ ರೀತಿಯ ಮೇಲ್‌ಬಾಕ್ಸ್‌ನಿಂದ ಆಮದುಗಳನ್ನು ನೀಡುವುದಿಲ್ಲ."

#: src/features/settings/OwnDomainCard.tsx
msgid "This server does not offer own domains. Ask its operator to turn them on."
msgstr "ಈ ಸರ್ವರ್ ಸ್ವಂತ ಡೊಮೇನ್‌ಗಳನ್ನು ಒದಗಿಸುವುದಿಲ್ಲ. ಅದರ ಆಪರೇಟರ್‌ಗೆ ಆನ್ ಮಾಡಲು ಕೇಳಿ."

#: src/features/migrations/SwitchStep.tsx
msgid "This server has no forwarding address, so the mail reaches Yuva through an MX change."
msgstr "ಈ ಸರ್ವರ್‌ಗೆ ಫಾರ್ವರ್ಡಿಂಗ್ ವಿಳಾಸವಿಲ್ಲ, ಹಾಗಾಗಿ ಮೇಲ್ MX ಬದಲಾವಣೆಯ ಮೂಲಕ Yuva ತಲುಪುತ್ತದೆ."

#: src/features/settings/slack/SlackPage.tsx
msgid "This server has no Slack app set up, so Slack cannot be connected."
msgstr "This server has no Slack app set up, so Slack cannot be connected."

#: src/components/common/text.ts
msgid "This server has no Slack app set up."
msgstr "This server has no Slack app set up."

#: src/features/settings/notifications/PushSection.tsx
msgid "This server is not set up to send push notifications."
msgstr "ಈ ಸರ್ವರ್ ಪುಶ್ ಅಧಿಸೂಚನೆಗಳನ್ನು ಕಳುಹಿಸಲು ಹೊಂದಿಸಲಾಗಿಲ್ಲ."

#: src/features/auth/CreateWorkspace.tsx
msgid "This server no longer lets people create workspaces. Ask your team for an invitation."
msgstr "ಈ ಸರ್ವರ್ ಇನ್ನು ವರ್ಕ್‌ಸ್ಪೇಸ್ ರಚಿಸಲು ಜನರಿಗೆ ಬಿಡುವುದಿಲ್ಲ. ನಿಮ್ಮ ತಂಡದಿಂದ ಆಹ್ವಾನ ಕೇಳಿ."

#: src/components/common/text.ts
msgid "This server runs as many migrations at once as it allows. Wait until a running one ends, or ask the server's operator."
msgstr "ಈ ಸರ್ವರ್ ಅನುಮತಿಸುವಷ್ಟು ಸ್ಥಳಾಂತರಗಳನ್ನು ಒಮ್ಮೆಗೆ ಚಲಾಯಿಸುತ್ತಿದೆ. ಚಾಲನೆಯಲ್ಲಿರುವ ಒಂದು ಮುಗಿಯುವವರೆಗೆ ಕಾಯಿರಿ, ಅಥವಾ ಸರ್ವರ್‌ನ ನಿರ್ವಾಹಕರನ್ನು ಕೇಳಿ."

#: src/features/broadcasts/BroadcastParts.tsx
msgid "This server sends broadcasts for a workspace once its operator approves it. An owner of the workspace can ask. Until then you can build lists, designs and drafts and send tests."
msgstr "ಸರ್ವರ್‌ನ ನಿರ್ವಾಹಕರು ಅನುಮೋದಿಸಿದ ನಂತರ ಈ ಸರ್ವರ್ ವರ್ಕ್‌ಸ್ಪೇಸ್‌ಗೆ ಬ್ರಾಡ್‌ಕಾಸ್ಟ್‌ಗಳನ್ನು ಕಳುಹಿಸುತ್ತದೆ. ವರ್ಕ್‌ಸ್ಪೇಸ್‌ನ ಮಾಲೀಕರು ಕೇಳಬಹುದು. ಅಲ್ಲಿಯವರೆಗೆ ನೀವು ಪಟ್ಟಿಗಳು, ವಿನ್ಯಾಸಗಳು ಮತ್ತು ಡ್ರಾಫ್ಟ್‌ಗಳನ್ನು ರಚಿಸಬಹುದು ಮತ್ತು ಪರೀಕ್ಷೆಗಳನ್ನು ಕಳುಹಿಸಬಹುದು."

#: src/features/broadcasts/BroadcastParts.tsx
msgid "This server sends broadcasts for a workspace once its operator approves it. Tell them about your mail to ask. Until then you can build lists, designs and drafts and send tests."
msgstr "ಸರ್ವರ್‌ನ ನಿರ್ವಾಹಕರು ಅನುಮೋದಿಸಿದ ನಂತರ ಈ ಸರ್ವರ್ ವರ್ಕ್‌ಸ್ಪೇಸ್‌ಗೆ ಬ್ರಾಡ್‌ಕಾಸ್ಟ್‌ಗಳನ್ನು ಕಳುಹಿಸುತ್ತದೆ. ಕೇಳಲು ನಿಮ್ಮ ಮೇಲ್ ಬಗ್ಗೆ ಅವರಿಗೆ ತಿಳಿಸಿ. ಅಲ್ಲಿಯವರೆಗೆ ನೀವು ಪಟ್ಟಿಗಳು, ವಿನ್ಯಾಸಗಳು ಮತ್ತು ಡ್ರಾಫ್ಟ್‌ಗಳನ್ನು ರಚಿಸಬಹುದು ಮತ್ತು ಪರೀಕ್ಷೆಗಳನ್ನು ಕಳುಹಿಸಬಹುದು."

#: src/features/home/HomePage.tsx
msgid "This server sends broadcasts only after its operator approves the workspace. Drafts are kept."
msgstr "ಆಪರೇಟರ್ ವರ್ಕ್‌ಸ್ಪೇಸ್ ಅನುಮೋದಿಸಿದ ನಂತರವೇ ಈ ಸರ್ವರ್ ಬ್ರಾಡ್‌ಕಾಸ್ಟ್ ಕಳುಹಿಸುತ್ತದೆ. ಕರಡುಗಳನ್ನು ಉಳಿಸಲಾಗುತ್ತದೆ."

#: src/components/common/text.ts
msgid "This server's limit for migrations is reached. Wait until a running one ends, or ask the server's operator."
msgstr "ಈ ಸರ್ವರ್‌ನ ಸ್ಥಳಾಂತರ ಮಿತಿ ತಲುಪಲಾಗಿದೆ. ಚಾಲನೆಯಲ್ಲಿರುವ ಒಂದು ಮುಗಿಯುವವರೆಗೆ ಕಾಯಿರಿ, ಅಥವಾ ಸರ್ವರ್‌ನ ನಿರ್ವಾಹಕರನ್ನು ಕೇಳಿ."

#: src/features/migrations/text.ts
msgid "This server's limit was reached"
msgstr "ಈ ಸರ್ವರ್‌ನ ಮಿತಿ ತಲುಪಲಾಗಿದೆ"

#: src/app/FocusQuestion.tsx
msgid "This sets what you see first. You can change it later in the workspace settings."
msgstr "ಇದು ನೀವು ಮೊದಲು ಏನು ನೋಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನಿರ್ಧರಿಸುತ್ತದೆ. ಇದನ್ನು ನಂತರ ವರ್ಕ್‌ಸ್ಪೇಸ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬದಲಾಯಿಸಬಹುದು."

#: src/features/account/ConnectPage.tsx
msgid "This site cannot connect"
msgstr "ಈ ಸೈಟ್ ಸಂಪರ್ಕಿಸಲಾಗದು"

#: src/components/common/text.ts
