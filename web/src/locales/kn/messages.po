msgid "The first rating makes the page appear here."
msgstr "ಮೊದಲ ರೇಟಿಂಗ್ ಪುಟವನ್ನು ಇಲ್ಲಿ ಕಾಣಿಸುವಂತೆ ಮಾಡುತ್ತದೆ."

#: src/features/settings/inboxes/InboxPage.tsx
