#: src/components/common/text.ts
msgid "This does not fit the inbox's purpose: {0}"
msgstr "ಇದು ಇನ್‌ಬಾಕ್ಸ್‌ನ ಉದ್ದೇಶಕ್ಕೆ ಹೊಂದುವುದಿಲ್ಲ: {0}"

#: src/components/common/text.ts
msgid "This does not fit the inbox's purpose."
msgstr "ಇದು ಇನ್‌ಬಾಕ್ಸ್‌ನ ಉದ್ದೇಶಕ್ಕೆ ಹೊಂದುವುದಿಲ್ಲ."

#: src/components/common/text.ts
msgid "This domain is already in the list."
msgstr "This domain is already in the list."

#: src/components/common/text.ts
msgid "This e-mail address bounced or complained, so the reply was not sent. Clear it on the contact to send again."
msgstr "ಈ ಇಮೇಲ್ ವಿಳಾಸ ಬೌನ್ಸ್ ಆಗಿದೆ ಅಥವಾ ದೂರು ನೀಡಿದೆ, ಹಾಗಾಗಿ ಉತ್ತರ ಕಳುಹಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಕಳುಹಿಸಲು ಸಂಪರ್ಕದಲ್ಲಿ ಅದನ್ನು ತೆರವುಗೊಳಿಸಿ."

#: src/features/settings/webhooks/WebhookWizard.tsx
msgid "This endpoint receives only the events of {lockedName}."
msgstr "ಈ ಎಂಡ್‌ಪಾಯಿಂಟ್ {lockedName} ನ ಈವೆಂಟ್‌ಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸುತ್ತದೆ."

#: src/components/common/text.ts
msgid "This file type is not allowed."
msgstr "ಈ ಫೈಲ್ ಪ್ರಕಾರವನ್ನು ಅನುಮತಿಸಲಾಗಿಲ್ಲ."

#: src/components/common/text.ts
msgid "This goal is a step of a funnel. Take it out of the funnel, or delete the funnel, first."
msgstr "ಈ ಗುರಿ ಫನೆಲ್‌ನ ಒಂದು ಹಂತ. ಮೊದಲು ಅದನ್ನು ಫನೆಲ್‌ನಿಂದ ತೆಗೆಯಿರಿ, ಅಥವಾ ಫನೆಲ್ ಅಳಿಸಿ."

#: src/components/common/text.ts
#: src/features/broadcasts/ListForm.tsx
msgid "This inbox already has a list with this name."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಈ ಹೆಸರಿನ ಪಟ್ಟಿ ಈಗಾಗಲೇ ಇದೆ."

#: src/components/common/text.ts
msgid "This inbox already has a status page."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ಗೆ ಈಗಾಗಲೇ ಸ್ಥಿತಿ ಪುಟವಿದೆ."

#: src/features/docs/InstallDialog.tsx
msgid "This inbox has no chat channel yet. Add one under <0>Add a channel</0>."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ಗೆ ಇನ್ನೂ ಚಾಟ್ ಚಾನಲ್ ಇಲ್ಲ. <0>ಚಾನಲ್ ಸೇರಿಸಿ</0> ಅಡಿಯಲ್ಲಿ ಒಂದನ್ನು ಸೇರಿಸಿ."

#: src/features/setup/NewsletterStep.tsx
msgid "This inbox has no e-mail channel that can send yet. You can create the list now; it sends once an e-mail channel with a reply account is picked in its settings."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ಗೆ ಇನ್ನೂ ಕಳುಹಿಸಬಲ್ಲ ಇಮೇಲ್ ಚಾನೆಲ್ ಇಲ್ಲ. ನೀವು ಈಗ ಪಟ್ಟಿ ರಚಿಸಬಹುದು; ಅದರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಉತ್ತರ ಖಾತೆಯಿರುವ ಇಮೇಲ್ ಚಾನೆಲ್ ಆರಿಸಿದಾಗ ಅದು ಕಳುಹಿಸುತ್ತದೆ."

#: src/features/status/SettingsTab.tsx
msgid "This inbox has no e-mail channel that can send. Add an SMTP account in the inbox settings."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಕಳುಹಿಸಲು ಸಾಧ್ಯವಿರುವ ಇಮೇಲ್ ಚಾನೆಲ್ ಇಲ್ಲ. ಇನ್‌ಬಾಕ್ಸ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ SMTP ಖಾತೆಯನ್ನು ಸೇರಿಸಿ."

#: src/features/broadcasts/ListForm.tsx
msgid "This inbox has no e-mail channel yet. Add one in the inbox settings."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ಗೆ ಇನ್ನೂ ಇಮೇಲ್ ಚಾನೆಲ್ ಇಲ್ಲ. ಇನ್‌ಬಾಕ್ಸ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಒಂದನ್ನು ಸೇರಿಸಿ."

#: src/features/broadcasts/Composer.tsx
msgid "This inbox has no e-mail channel. Add one with an SMTP account to send broadcasts."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ಗೆ ಇಮೇಲ್ ಚಾನೆಲ್ ಇಲ್ಲ. ಬ್ರಾಡ್‌ಕಾಸ್ಟ್‌ಗಳನ್ನು ಕಳುಹಿಸಲು SMTP ಖಾತೆಯಿರುವ ಒಂದನ್ನು ಸೇರಿಸಿ."

#: src/features/broadcasts/AudienceBuilder.tsx
msgid "This inbox has no mailing list yet. A broadcast goes only to people who subscribed to a list."
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್‌ಗೆ ಇನ್ನೂ ಮೇಲಿಂಗ್ ಪಟ್ಟಿ ಇಲ್ಲ. ಬ್ರಾಡ್‌ಕಾಸ್ಟ್ ಪಟ್ಟಿಗೆ ಚಂದಾದಾರರಾದವರಿಗೆ ಮಾತ್ರ ಹೋಗುತ್ತದೆ."

#: src/features/settings/inboxes/InboxPage.tsx
msgid "This inbox is for"
msgstr "ಈ ಇನ್‌ಬಾಕ್ಸ್ ಇದಕ್ಕಾಗಿ"

#: src/features/migrations/UploadStep.tsx
msgid "This is a compressed archive. Unzip the Takeout archive and upload the .mbox file."
msgstr "ಇದು ಸಂಕುಚಿತ ಆರ್ಕೈವ್. Takeout ಆರ್ಕೈವ್ ಅನ್‌ಜಿಪ್ ಮಾಡಿ .mbox ಫೈಲ್ ಅಪ್‌ಲೋಡ್ ಮಾಡಿ."

#: src/features/status/IncidentDetail.tsx
msgid "This is a draft. Only your team sees it, and it changes no component until you publish it."
msgstr "ಇದು ಕರಡು. ಇದನ್ನು ನಿಮ್ಮ ತಂಡ ಮಾತ್ರ ನೋಡುತ್ತದೆ ಮತ್ತು ನೀವು ಪ್ರಕಟಿಸುವವರೆಗೆ ಯಾವುದೇ ಘಟಕವನ್ನು ಬದಲಾಯಿಸುವುದಿಲ್ಲ."

#: src/components/common/text.ts
msgid "This is neither an mbox file nor a zip. Upload the .mbox file itself, or a .zip of .eml files or of a Maildir."
msgstr "ಇದು mbox ಫೈಲ್ ಅಲ್ಲ, zip ಕೂಡ ಅಲ್ಲ. .mbox ಫೈಲ್ ಅನ್ನೇ, ಅಥವಾ .eml ಫೈಲ್‌ಗಳ ಅಥವಾ Maildir ನ .zip ಅನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ."

#: src/components/common/text.ts
msgid "This is not a CSV file. Save the spreadsheet as CSV and upload that."
msgstr "ಇದು CSV ಫೈಲ್ ಅಲ್ಲ. ಸ್ಪ್ರೆಡ್‌ಶೀಟ್ ಅನ್ನು CSV ಆಗಿ ಉಳಿಸಿ ಮತ್ತು ಅದನ್ನು ಅಪ್‌ಲೋಡ್ ಮಾಡಿ."

#: src/features/settings/OwnDomainCard.tsx
msgid "This is not a domain this page can use. Use a name like {example} that is not one of this server’s own addresses."
msgstr "ಈ ಪುಟ ಈ ಡೊಮೇನ್ ಬಳಸಲಾಗದು. {example} ನಂತಹ, ಈ ಸರ್ವರ್‌ನ ಸ್ವಂತ ವಿಳಾಸಗಳಲ್ಲದ ಹೆಸರನ್ನು ಬಳಸಿ."

#: src/features/settings/channels/ApiChannelDialog.tsx
#: src/features/settings/channels/sections.tsx
msgid "This is not a JSON object."
msgstr "ಇದು JSON ಆಬ್ಜೆಕ್ಟ್ ಅಲ್ಲ."

#: src/components/common/text.ts
#: src/features/broadcasts/AddSubscriberDialog.tsx
#: src/features/status/AddSubscriberDialog.tsx
msgid "This is not a valid e-mail address."
msgstr "ಇದು ಮಾನ್ಯ ಇಮೇಲ್ ವಿಳಾಸವಲ್ಲ."

#: src/features/migrations/UploadStep.tsx
msgid "This is not the file whose {count} parts are on the server. Pick that file again to continue, or send this one from the start."
msgstr "{count} ಭಾಗಗಳು ಸರ್ವರ್‌ನಲ್ಲಿರುವ ಫೈಲ್ ಇದಲ್ಲ. ಮುಂದುವರಿಸಲು ಆ ಫೈಲ್ ಅನ್ನು ಮತ್ತೆ ಆರಿಸಿ, ಅಥವಾ ಇದನ್ನು ಮೊದಲಿನಿಂದ ಕಳುಹಿಸಿ."

#: src/features/migrations/ReviewStep.tsx
msgid "This is the dry run for {address}. Nothing is imported until you start."
msgstr "ಇದು {address} ಗಾಗಿ ಪ್ರಯೋಗ ಚಾಲನೆ. ನೀವು ಆರಂಭಿಸುವವರೆಗೆ ಏನೂ ಆಮದಾಗುವುದಿಲ್ಲ."

#: src/features/migrations/ReviewStep.tsx
msgid "This is the dry run for {provider}. Nothing is imported until you start."
msgstr "ಇದು {provider} ಗಾಗಿ ಪ್ರಯೋಗ ಚಾಲನೆ. ನೀವು ಆರಂಭಿಸುವವರೆಗೆ ಏನೂ ಆಮದಾಗುವುದಿಲ್ಲ."

#: src/features/setup/InstallStep.tsx
msgid "This is the live chat, as it looks on your site. You can try it here."
msgstr "ಇದು ನಿಮ್ಮ ಸೈಟ್‌ನಲ್ಲಿ ಕಾಣುವಂತೆ ಲೈವ್ ಚಾಟ್. ನೀವು ಇಲ್ಲಿ ಪ್ರಯತ್ನಿಸಬಹುದು."

#: src/features/oauth/ConsentPage.tsx
msgid "This is the name the app gives itself. Yuva has not verified it."
msgstr "ಇದು ಆ್ಯಪ್ ತನಗೆ ತಾನೇ ಕೊಡುವ ಹೆಸರು. Yuva ಅದನ್ನು ಪರಿಶೀಲಿಸಿಲ್ಲ."

#: src/components/common/text.ts
msgid "This issue or this item has as many links as allowed."
msgstr "This issue or this item has as many links as allowed."

#: src/features/account/ConnectPage.tsx
msgid "This link is incomplete"
msgstr "ಈ ಲಿಂಕ್ ಅಪೂರ್ಣವಾಗಿದೆ"

#: src/components/common/ShortcutSheet.tsx
msgid "This list"
msgstr "ಈ ಪಟ್ಟಿ"

#: src/features/broadcasts/ListPage.tsx
msgid "This list has no e-mail channel that can send, so forms send no confirmation, new form subscribers keep waiting and nobody gets a welcome mail."
msgstr "ಈ ಪಟ್ಟಿಗೆ ಕಳುಹಿಸಬಲ್ಲ ಇಮೇಲ್ ಚಾನೆಲ್ ಇಲ್ಲ, ಹಾಗಾಗಿ ಫಾರ್ಮ್‌ಗಳು ದೃಢೀಕರಣ ಕಳುಹಿಸುವುದಿಲ್ಲ, ಫಾರ್ಮ್‌ನ ಹೊಸ ಚಂದಾದಾರರು ಕಾಯುತ್ತಲೇ ಇರುತ್ತಾರೆ ಮತ್ತು ಯಾರಿಗೂ ಸ್ವಾಗತ ಮೇಲ್ ಸಿಗುವುದಿಲ್ಲ."

#: src/features/broadcasts/AddSubscriberDialog.tsx
#: src/features/broadcasts/Import.tsx
msgid "This list has no e-mail channel that can send, so it cannot mail a confirmation yet."
msgstr "ಈ ಪಟ್ಟಿಗೆ ಕಳುಹಿಸಬಲ್ಲ ಇಮೇಲ್ ಚಾನೆಲ್ ಇಲ್ಲ, ಹಾಗಾಗಿ ಅದು ಇನ್ನೂ ದೃಢೀಕರಣ ಮೇಲ್ ಕಳುಹಿಸಲಾರದು."

#: src/features/broadcasts/ListForm.tsx
msgid "This list has no e-mail channel that can send. Until it has one, forms send no confirmation mail, new form subscribers stay waiting for confirmation and nobody gets a welcome mail. Pick an e-mail channel with an SMTP account below, or add the SMTP account in the inbox settings."
msgstr "ಈ ಪಟ್ಟಿಗೆ ಕಳುಹಿಸಬಲ್ಲ ಇಮೇಲ್ ಚಾನೆಲ್ ಇಲ್ಲ. ಒಂದು ಬರುವವರೆಗೆ, ಫಾರ್ಮ್‌ಗಳು ದೃಢೀಕರಣ ಮೇಲ್ ಕಳುಹಿಸುವುದಿಲ್ಲ, ಫಾರ್ಮ್‌ನ ಹೊಸ ಚಂದಾದಾರರು ದೃಢೀಕರಣಕ್ಕಾಗಿ ಕಾಯುತ್ತಾರೆ ಮತ್ತು ಯಾರಿಗೂ ಸ್ವಾಗತ ಮೇಲ್ ಸಿಗುವುದಿಲ್ಲ. ಕೆಳಗೆ SMTP ಖಾತೆಯಿರುವ ಇಮೇಲ್ ಚಾನೆಲ್ ಆರಿಸಿ, ಅಥವಾ ಇನ್‌ಬಾಕ್ಸ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ SMTP ಖಾತೆ ಸೇರಿಸಿ."

#: src/features/broadcasts/ListPage.tsx
msgid "This list is archived. It takes no new subscribers and broadcasts cannot pick it."
msgstr "ಈ ಪಟ್ಟಿ ಆರ್ಕೈವ್ ಆಗಿದೆ. ಇದು ಹೊಸ ಚಂದಾದಾರರನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ ಮತ್ತು ಬ್ರಾಡ್‌ಕಾಸ್ಟ್‌ಗಳು ಇದನ್ನು ಆರಿಸಲಾಗದು."

#: src/features/broadcasts/FormSnippets.tsx
msgid "This list is private, so forms do not offer it. Make it public in the settings to use a form."
msgstr "ಈ ಪಟ್ಟಿ ಖಾಸಗಿ, ಹಾಗಾಗಿ ಫಾರ್ಮ್‌ಗಳು ಅದನ್ನು ನೀಡುವುದಿಲ್ಲ. ಫಾರ್ಮ್ ಬಳಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಸಾರ್ವಜನಿಕಗೊಳಿಸಿ."

#: src/features/mail/MailThread.tsx
msgid "This mail is not available"
msgstr "ಈ ಮೇಲ್ ಲಭ್ಯವಿಲ್ಲ"

#: src/features/mail/Compose.tsx
msgid "This mail needs a recipient, a subject and some text before it can be kept as a draft."
msgstr "ಈ ಮೇಲ್ ಅನ್ನು ಕರಡಾಗಿ ಇರಿಸಲು ಸ್ವೀಕರಿಸುವವರು, ವಿಷಯ ಮತ್ತು ಸ್ವಲ್ಪ ಪಠ್ಯ ಬೇಕು."

#: src/features/migrations/SourceStep.tsx
msgid "This mailbox connects only with “Sign in with Microsoft”, which this Yuva server does not offer. Ask its operator to set it up."
msgstr "ಈ ಮೇಲ್‌ಬಾಕ್ಸ್ “Microsoft ನೊಂದಿಗೆ ಸೈನ್ ಇನ್” ಮೂಲಕ ಮಾತ್ರ ಸಂಪರ್ಕಿಸುತ್ತದೆ, ಇದನ್ನು ಈ Yuva ಸರ್ವರ್ ನೀಡುವುದಿಲ್ಲ. ಅದನ್ನು ಹೊಂದಿಸಲು ಅದರ ನಿರ್ವಾಹಕರನ್ನು ಕೇಳಿ."

#: src/features/team/TeamPage.tsx
msgid "This member is not in the workspace any more."
msgstr "ಈ ಸದಸ್ಯರು ಇನ್ನು ವರ್ಕ್‌ಸ್ಪೇಸ್‌ನಲ್ಲಿಲ್ಲ."

#: src/features/conversation/messages/Thread.tsx
msgid "This message"
msgstr "ಈ ಸಂದೇಶ"

#: src/features/migrations/UploadStep.tsx
msgid "This migration has ended, so nothing more can be uploaded. Start a new one for another file."
msgstr "ಈ ಸ್ಥಳಾಂತರ ಮುಗಿದಿದೆ, ಹಾಗಾಗಿ ಇನ್ನೇನೂ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗದು. ಇನ್ನೊಂದು ಫೈಲ್‌ಗಾಗಿ ಹೊಸದನ್ನು ಆರಂಭಿಸಿ."

#: src/features/reports/TrendsReport.tsx
#: src/features/settings/connected-apps/ConnectedAppsPage.tsx
msgid "This month"
msgstr "ಈ ತಿಂಗಳು"

#: src/features/status/IncidentDialog.tsx
msgid "This page is not public yet, so visitors see nothing until you publish the page."
msgstr "ಈ ಪುಟ ಇನ್ನೂ ಸಾರ್ವಜನಿಕವಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ ನೀವು ಪುಟವನ್ನು ಪ್ರಕಟಿಸುವವರೆಗೆ ಸಂದರ್ಶಕರಿಗೆ ಏನೂ ಕಾಣುವುದಿಲ್ಲ."

#: src/components/common/text.ts
msgid "This person unsubscribed from everything, reported a mail as spam or had their data erased, so the team cannot add them again."
msgstr "ಈ ವ್ಯಕ್ತಿ ಎಲ್ಲದರಿಂದ ಚಂದಾದಾರಿಕೆ ರದ್ದುಪಡಿಸಿದ್ದಾರೆ, ಮೇಲ್ ಅನ್ನು ಸ್ಪ್ಯಾಮ್ ಎಂದು ವರದಿ ಮಾಡಿದ್ದಾರೆ ಅಥವಾ ಅವರ ಡೇಟಾ ಅಳಿಸಲಾಗಿದೆ, ಹಾಗಾಗಿ ತಂಡ ಅವರನ್ನು ಮತ್ತೆ ಸೇರಿಸಲಾಗದು."

#: src/components/common/text.ts
msgid "This place holds as many views as allowed (50). Delete one first."
msgstr "ಇಲ್ಲಿ ಅನುಮತಿಸಿದ ಗರಿಷ್ಠ ವೀಕ್ಷಣೆಗಳು (50) ಇವೆ. ಮೊದಲು ಒಂದನ್ನು ಅಳಿಸಿ."

#: src/components/common/text.ts
msgid "This property already has a funnel with this name."
msgstr "ಈ ಪ್ರಾಪರ್ಟಿಯಲ್ಲಿ ಈ ಹೆಸರಿನ ಫನೆಲ್ ಈಗಾಗಲೇ ಇದೆ."

#: src/components/common/text.ts
msgid "This property already has a goal with this name."
msgstr "ಈ ಪ್ರಾಪರ್ಟಿಯಲ್ಲಿ ಈ ಹೆಸರಿನ ಗುರಿ ಈಗಾಗಲೇ ಇದೆ."

#: src/components/common/text.ts
msgid "This property already has a segment with this name."
msgstr "ಈ ಪ್ರಾಪರ್ಟಿಯಲ್ಲಿ ಈ ಹೆಸರಿನ ಸೆಗ್ಮೆಂಟ್ ಈಗಾಗಲೇ ಇದೆ."

#: src/features/settings/automation/RuleList.tsx
msgid "This reply will not be sent until an owner or admin saves both this rule and the canned reply {title}, or bots may send is turned on in the API key settings."
msgstr "ಮಾಲೀಕರು ಅಥವಾ ನಿರ್ವಾಹಕರು ಈ ನಿಯಮ ಮತ್ತು ಸಿದ್ಧ ಉತ್ತರ {title} ಎರಡನ್ನೂ ಉಳಿಸುವವರೆಗೆ, ಅಥವಾ API ಕೀ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬಾಟ್‌ಗಳಿಗೆ ಕಳುಹಿಸಲು ಅನುಮತಿ ಸಿಗುವವರೆಗೆ ಈ ಉತ್ತರ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."

#: src/features/settings/automation/RuleDialog.tsx
#: src/features/settings/automation/RuleList.tsx
msgid "This reply will not be sent until an owner or admin saves the canned reply {title}, or bots may send is turned on in the API key settings."
msgstr "ಮಾಲೀಕರು ಅಥವಾ ನಿರ್ವಾಹಕರು ಸಿದ್ಧ ಉತ್ತರ {title} ಅನ್ನು ಉಳಿಸುವವರೆಗೆ, ಅಥವಾ API ಕೀ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬಾಟ್‌ಗಳಿಗೆ ಕಳುಹಿಸಲು ಅನುಮತಿ ಸಿಗುವವರೆಗೆ ಈ ಉತ್ತರ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."

#: src/features/settings/automation/RuleList.tsx
msgid "This reply will not be sent until an owner or admin saves this rule, or bots may send is turned on in the API key settings."
msgstr "ಮಾಲೀಕರು ಅಥವಾ ನಿರ್ವಾಹಕರು ಈ ನಿಯಮವನ್ನು ಉಳಿಸುವವರೆಗೆ, ಅಥವಾ API ಕೀ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬಾಟ್‌ಗಳಿಗೆ ಕಳುಹಿಸಲು ಅನುಮತಿ ಸಿಗುವವರೆಗೆ ಈ ಉತ್ತರ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."

#: src/features/oauth/ConsentPage.tsx
msgid "This request expired or was already used. Start connecting again from the app."
msgstr "ಈ ವಿನಂತಿಯ ಅವಧಿ ಮುಗಿದಿದೆ ಅಥವಾ ಈಗಾಗಲೇ ಬಳಸಲಾಗಿದೆ. ಆ್ಯಪ್‌ನಿಂದ ಮತ್ತೆ ಸಂಪರ್ಕಿಸುವುದನ್ನು ಆರಂಭಿಸಿ."

#: src/features/oauth/ConsentPage.tsx
msgid "This request has ended"
msgstr "ಈ ವಿನಂತಿ ಮುಗಿದಿದೆ"

