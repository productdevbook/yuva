#: src/features/migrations/text.ts
msgid "{provider} did not accept the user name or password. Check both, or create a new app password."
msgstr "{provider} ಬಳಕೆದಾರ ಹೆಸರು ಅಥವಾ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಸ್ವೀಕರಿಸಲಿಲ್ಲ. ಎರಡನ್ನೂ ಪರಿಶೀಲಿಸಿ, ಅಥವಾ ಹೊಸ ಆ್ಯಪ್ ಪಾಸ್‌ವರ್ಡ್ ರಚಿಸಿ."

#: src/features/migrations/text.ts
msgid "{provider} did not give Yuva access. Sign in again and allow access on {provider}'s page."
msgstr "{provider} Yuva ಗೆ ಪ್ರವೇಶ ನೀಡಲಿಲ್ಲ. ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಿ ಮತ್ತು {provider} ಪುಟದಲ್ಲಿ ಪ್ರವೇಶವನ್ನು ಅನುಮತಿಸಿ."

#: src/features/migrations/text.ts
msgid "{provider} granted more than read access"
msgstr "{provider} ಓದುವ ಪ್ರವೇಶಕ್ಕಿಂತ ಹೆಚ್ಚು ನೀಡಿದೆ"

