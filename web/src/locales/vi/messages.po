msgid "Paused"
msgstr "Đã tạm dừng"

#: src/components/common/text.ts
msgid "Paused because Amazon SES paused this inbox's tenant, or the channel lost its tenant isolation. Resume it once the server's operator has fixed that."
msgstr "Đã tạm dừng vì Amazon SES đã tạm dừng tenant của hộp thư này, hoặc kênh mất cách ly tenant. Hãy tiếp tục sau khi người vận hành máy chủ khắc phục."

#: src/components/common/text.ts
msgid "Paused because the workspace may not send broadcasts for now."
msgstr "Đã tạm dừng vì không gian làm việc hiện không được gửi thư hàng loạt."

#: src/components/common/text.ts
msgid "Paused by the server's operator."
msgstr "Bị người vận hành máy chủ tạm dừng."

#: src/components/common/text.ts
msgid "Paused by your team."
msgstr "Bị nhóm của bạn tạm dừng."

#: src/components/common/text.ts
msgid "Paused on its own: 0.3% or more of the recipients reported the mail as spam, the most mail providers accept. Make sure everyone on the lists asked for this mail before you resume."
msgstr "Tự tạm dừng: từ 0,3% người nhận trở lên đã báo thư là thư rác, mức cao nhất mà hầu hết nhà cung cấp thư chấp nhận. Hãy chắc chắn mọi người trong các danh sách đã yêu cầu thư này trước khi tiếp tục."

#: src/components/common/text.ts
msgid "Paused on its own: 5% or more of the mails sent bounced. Check the list for old or mistyped addresses before you resume."
msgstr "Tự tạm dừng: từ 5% thư đã gửi trở lên bị trả lại. Hãy kiểm tra danh sách xem có địa chỉ cũ hoặc gõ sai không trước khi tiếp tục."

#: src/components/common/text.ts
msgid "Paused on its own: the SMTP server refused the account, its encryption or too many mails in a row. Check the channel's broadcast account, then resume."
msgstr "Tự tạm dừng: máy chủ SMTP từ chối tài khoản, cách mã hóa của nó hoặc quá nhiều thư liên tiếp. Hãy kiểm tra tài khoản thư hàng loạt của kênh, rồi tiếp tục."

#: src/features/migrations/CopyStep.tsx
msgid "Paused. Nothing is read from {address} until you resume."
msgstr "Đã tạm dừng. Không có gì được đọc từ {address} cho đến khi bạn tiếp tục."

#: src/features/migrations/CopyStep.tsx
